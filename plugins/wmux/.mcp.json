{
  "mcpServers": {
    "wmux": {
      "command": "node",
      "args": ["./scripts/wmux-mcp.mjs"],
      "cwd": ".",
      "env_vars": [
        "WMUX_WORKSPACE_ID",
        "WMUX_TAB_ID",
        "WMUX_PANE_ID",
        "WMUX_URL",
        "WMUX_HELPER_URL",
        "WMUX_PUBLIC_URL",
        "WMUX_HELPER_TOKEN",
        "WMUX_HELPER_TOKEN_PATH",
        "WMUX_TOKEN",
        "WMUX_TOKEN_PATH",
        "WMUX_BROWSER_AUTH_MODE",
        "WMUX_ALLOWED_HOSTS"
      ]
    }
  }
}
