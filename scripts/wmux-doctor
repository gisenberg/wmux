#!/usr/bin/env node
import fs from "node:fs";
import http from "node:http";
import https from "node:https";
import os from "node:os";
import path from "node:path";

const wmuxHome = path.join(os.homedir(), ".wmux");
const read = (name) => {
  try {
    return fs.readFileSync(path.join(wmuxHome, name), "utf8").trim();
  } catch {
    return "";
  }
};
const baseUrl = (process.env.WMUX_URL || read("url") || "http://127.0.0.1:3478").replace(/\/+$/, "");
const scopedToken = () => {
  const envConfigured = Object.hasOwn(process.env, "WMUX_HELPER_TOKEN");
  const envToken = process.env.WMUX_HELPER_TOKEN?.trim() ?? "";
  if (envConfigured && !/^[A-Za-z0-9_-]{32,256}$/.test(envToken)) {
    throw new Error("configured helper token is empty or malformed");
  }
  const pathConfigured = Object.hasOwn(process.env, "WMUX_HELPER_TOKEN_PATH");
  if (pathConfigured && !process.env.WMUX_HELPER_TOKEN_PATH?.trim()) throw new Error("configured helper token path is empty");
  const tokenPath = process.env.WMUX_HELPER_TOKEN_PATH || path.join(wmuxHome, "helper-token");
  if (pathConfigured || fs.existsSync(tokenPath)) {
    let value = "";
    try { value = fs.readFileSync(tokenPath, "utf8").trim(); } catch {}
    if (!/^[A-Za-z0-9_-]{32,256}$/.test(value)) throw new Error("configured helper token file is unreadable or malformed");
    return value;
  }
  return envConfigured ? envToken : null;
};
let token;
try {
  const helperToken = scopedToken();
  token = helperToken ?? (process.env.WMUX_BROWSER_AUTH_MODE === "login-only" ? "" : process.env.WMUX_TOKEN || read("token"));
} catch (error) {
  console.error(`wmux doctor failed: ${error instanceof Error ? error.message : "invalid helper credential"}`);
  process.exit(2);
}
const requestDoctor = () => new Promise((resolve, reject) => {
  const url = new URL(`${baseUrl}/api/doctor`);
  const client = url.protocol === "https:" ? https : http;
  const request = client.request(url, {
    method: "GET",
    headers: {
      connection: "close",
      ...(token ? { authorization: `Bearer ${token}` } : {}),
    },
  }, (response) => {
    const chunks = [];
    response.on("data", (chunk) => chunks.push(Buffer.from(chunk)));
    response.on("end", () => resolve({ status: response.statusCode ?? 0, body: Buffer.concat(chunks).toString("utf8") }));
  });
  request.setTimeout(10_000, () => request.destroy(new Error("request timed out after 10000ms")));
  request.on("error", reject);
  request.end();
});

let response;
let lastError;
for (let attempt = 0; attempt < 3; attempt += 1) {
  try {
    response = await requestDoctor();
    break;
  } catch (error) {
    lastError = error;
    if (attempt < 2) await new Promise((resolve) => setTimeout(resolve, 200 * (attempt + 1)));
  }
}
if (!response) {
  console.error(`wmux doctor failed: ${lastError instanceof Error ? lastError.message : String(lastError)}`);
  process.exit(1);
}
if (response.status < 200 || response.status >= 300) {
  console.error(`wmux doctor failed: HTTP ${response.status} ${response.body}`);
  process.exit(1);
}
const report = JSON.parse(response.body);
if (process.argv.includes("--json")) {
  console.log(JSON.stringify(report, null, 2));
  process.exit(0);
}
const summary = report.summary;
console.log(`wmux doctor (${report.checkedAt})`);
console.log(`${summary.paneCount} panes, ${summary.restartDurablePaneCount} restart-durable, ${summary.exitedPaneCount} exited, ${summary.sessionIssueCount} session issues`);
const persistenceFailed = Boolean(report.persistence?.failureCount);
if (report.persistence) {
  const health = report.persistence;
  console.log(`${persistenceFailed ? "[WARN]" : "[OK]"} state persistence: ${health.dirty ? "pending" : "saved"}${health.errorCode ? ` (${health.errorCode}; retrying)` : ""}`);
}
for (const pane of report.panes) {
  const state = pane.issue ? "issue" : pane.status;
  console.log(`${state.padEnd(8)} ${pane.transport.padEnd(18)} ${pane.machineName.padEnd(14)} ${pane.title}${pane.issue ? ` - ${pane.issue}` : ""}`);
}
const age = (value) => {
  if (!Number.isFinite(value)) return "not sampled";
  const seconds = Math.max(0, Math.floor((Date.now() - value) / 1_000));
  if (seconds < 60) return `${seconds}s ago`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  return hours < 24 ? `${hours}h ago` : `${Math.floor(hours / 24)}d ago`;
};
const expiry = (value) => {
  const timestamp = Date.parse(value);
  if (!Number.isFinite(timestamp)) return "expiry unknown";
  const seconds = Math.floor((timestamp - Date.now()) / 1_000);
  if (seconds <= 0) return `expired ${age(timestamp)}`;
  return seconds < 60 ? `expires in ${seconds}s` : `expires in ${Math.floor(seconds / 60)}m`;
};
const observation = (label, value) => {
  if (!value) return `${label} unknown (not sampled)`;
  const reason = value.reason ? ` - ${value.reason}` : "";
  return `${label} ${value.status}${value.stale ? " / stale" : ""}; sample ${age(value.sampledAt)}; success ${age(value.lastSuccessAt)}${reason}`;
};
const codex = report.codex;
if (codex) {
  console.log(`codex: ${codex.bindings.length} bindings, ${codex.pendingCount} pending, ${codex.expiredCount} expired`);
  console.log(`codex compatibility: cli ${codex.compatibility.cli}, server ${codex.compatibility.server}, plugins ${codex.compatibility.pluginVersions.join(", ") || "unverified"}`);
  for (const binding of codex.bindings) {
    console.log(`codex ${binding.binding.padEnd(11)} workspace=${binding.workspaceId} tab=${binding.tabId} pane=${binding.paneId} session=${binding.sessionId} ${expiry(binding.expiresAt)}`);
    console.log(`  pins workspace=${binding.workspaceOwnership} tab=${binding.tabOwnership}; ${observation("naming", binding.naming)}; ${observation("activity", binding.activity)}`);
    if (binding.binding === "expired") {
      console.log("  recovery: establish fresh terminal proof before automatic naming can resume");
    } else if (binding.binding === "unavailable") {
      console.log("  recovery: establish fresh terminal proof; socket recovery alone does not restore title authority");
    }
  }
}
process.exit(summary.exitedPaneCount || summary.sessionIssueCount || persistenceFailed || codex?.expiredCount ? 1 : 0);
