#!/usr/bin/env python3
"""Run a delegated request, or supervise an interactive TUI, from Base64 JSON."""
import base64
import json
import os
import re
import selectors
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from wmux_agent_contract import (
    AGENT_DONE,
    AGENT_READY,
    AGENT_RESULT,
    AGENT_TUI_ACK,
    AGENT_TUI_EXIT,
    AGENT_TUI_LAUNCH,
    AGENT_TUI_READY,
    AGENT_TUI_RELEASE,
    HELP_PROBE_TIMEOUT,
    MAX_BLANK_REQUEST_LINES,
    MAX_DIRECTORY,
    MAX_HELP_OUTPUT,
    MAX_LINE,
    MAX_OPTION_TEXT,
    MAX_PROMPT,
    MAX_RUN_ID,
    MAX_TEXT,
    OUTCOME_SCHEMA,
    RESULT_FORMATS,
    RUNTIMES,
    SANDBOX_MODES,
    TERMINATION_GRACE,
)

RUN_ID_RE = r"[A-Za-z0-9._-]{1,%d}" % MAX_RUN_ID


def bounded(value):
    if not isinstance(value, str):
        return ""
    encoded = value.encode("utf-8")
    if len(encoded) <= MAX_TEXT:
        return value
    return encoded[:MAX_TEXT].decode("utf-8", errors="ignore")


def append_bounded(current, value):
    return bounded((current + "\n" if current else "") + value)


def emit(kind, value):
    encoded = base64.b64encode(json.dumps(value, separators=(",", ":")).encode()).decode()
    print("%s %s" % (kind, encoded), flush=True)


def fail(run_id, message, code=2):
    emit(AGENT_RESULT, {"runId": run_id, "ok": False, "error": bounded(message)})
    print("%s %s %d" % (AGENT_DONE, run_id, code), flush=True)
    return code


def read_request_line():
    for _attempt in range(MAX_BLANK_REQUEST_LINES + 1):
        line = sys.stdin.buffer.readline(MAX_LINE + 1)
        if len(line) > MAX_LINE:
            raise ValueError("request is too large")
        if line.strip():
            return line
        if not line:
            break
    raise ValueError("request must be Base64 JSON")


def request_from_stdin(marker=AGENT_READY):
    tty_state = None
    if sys.stdin.isatty() and os.name == "nt":
        import msvcrt

        print(marker, flush=True)
        while True:
            characters = []
            while True:
                character = msvcrt.getwch()
                if character in {"\r", "\n"}:
                    break
                if character == "\x03":
                    raise KeyboardInterrupt
                if character in {"\x00", "\xe0"}:
                    msvcrt.getwch()
                    continue
                characters.append(character)
                if len("".join(characters).encode("utf-8")) > MAX_LINE:
                    raise ValueError("request is too large")
            if characters:
                print(flush=True)
                line = "".join(characters).encode("utf-8")
                break
    elif sys.stdin.isatty():
        import termios

        tty_state = termios.tcgetattr(sys.stdin.fileno())
        quiet = termios.tcgetattr(sys.stdin.fileno())
        quiet[3] &= ~termios.ECHO
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, quiet)
        try:
            print(marker, flush=True)
            line = read_request_line()
        finally:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, tty_state)
            print(flush=True)
    else:
        print(marker, flush=True)
        line = read_request_line()
    try:
        request = json.loads(base64.b64decode(line.strip(), validate=True))
    except Exception as error:
        raise ValueError("request must be Base64 JSON") from error
    if not isinstance(request, dict):
        raise ValueError("request must be an object")
    return request


def validate(request, tui=False):
    run_id, prompt, directory = (request.get(key) for key in ("runId", "prompt", "directory"))
    runtime = request.get("runtime") or os.environ.get("WMUX_AGENT_RUNTIME_DEFAULT")
    valid_id = isinstance(run_id, str) and 0 < len(run_id) <= MAX_RUN_ID and all(
        char in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for char in run_id
    )
    if not valid_id:
        raise ValueError("invalid runId")
    if runtime not in RUNTIMES:
        raise ValueError("runtime must be opencode, codex, claude, or prime-agent")
    if not tui and (not isinstance(prompt, str) or not prompt or len(prompt.encode()) > MAX_PROMPT):
        raise ValueError("invalid prompt")
    if not isinstance(directory, str) or len(directory) > MAX_DIRECTORY or "\x00" in directory:
        raise ValueError("invalid directory")
    if tui and not directory.startswith("/"):
        raise ValueError("invalid directory")
    directory = os.path.abspath(os.path.expanduser(directory))
    if not os.path.isdir(directory):
        raise ValueError("directory does not exist")
    for key in ("agent", "model", "title"):
        if key in request and (not isinstance(request[key], str) or len(request[key]) > MAX_OPTION_TEXT or "\x00" in request[key]):
            raise ValueError("invalid %s" % key)
    for key in ("unattended", "writeAccess"):
        if key in request and not isinstance(request[key], bool):
            raise ValueError("invalid %s" % key)
    sandbox_mode = request.get("sandboxMode")
    if sandbox_mode is not None and sandbox_mode not in SANDBOX_MODES:
        raise ValueError("sandboxMode must be read-only, workspace-write, or danger-full-access")
    result_format = request.get("resultFormat")
    if result_format is not None and result_format not in RESULT_FORMATS:
        raise ValueError("resultFormat must be outcome-v1")
    if result_format and runtime != "codex":
        raise ValueError("structured outcomes currently require the Codex runtime")
    if tui:
        if "prompt" in request:
            raise ValueError("interactive request must not contain prompt")
        allowed = {"runId", "runtime", "directory", "model", "agent", "unattended", "writeAccess", "sandboxMode", "codexRemote", "codexAttachFile"}
        unknown = sorted(set(request) - allowed)
        if unknown:
            raise ValueError("interactive request contains forbidden key: %s" % unknown[0])
        if "agent" in request and runtime != "opencode":
            raise ValueError("interactive agent is only valid for opencode")
        if "sandboxMode" in request and runtime != "codex":
            raise ValueError("interactive sandbox mode is only valid for codex")
        if request.get("unattended") is True and runtime != "codex":
            raise ValueError("interactive unattended mode is only valid for codex")
        if "codexRemote" in request:
            if runtime != "codex":
                raise ValueError("interactive Codex remote is only valid for codex")
            validate_codex_remote(request["codexRemote"])
        if "codexAttachFile" in request:
            if runtime != "codex" or not isinstance(request["codexAttachFile"], str):
                raise ValueError("interactive Codex attachment is only valid for codex")
            if any(key in request for key in ("model", "agent", "unattended", "writeAccess", "sandboxMode", "codexRemote")):
                raise ValueError("interactive Codex attachment forbids launch overrides")
    return run_id, runtime, prompt, directory


def private_regular(pathname):
    entry = os.lstat(pathname)
    return stat.S_ISREG(entry.st_mode) and not stat.S_ISLNK(entry.st_mode) and entry.st_uid == os.getuid() and not (entry.st_mode & 0o077)


def proc_start(pid):
    try:
        with open("/proc/%d/stat" % pid, "r", encoding="utf-8") as handle:
            # comm is parenthesized and may contain spaces; field 22 is the
            # twentieth field following that closing parenthesis.
            fields = handle.read().rsplit(")", 1)[1].split()
            return fields[19]
    except (OSError, IndexError):
        return ""


def proc_argv(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as handle:
            return [part.decode("utf-8", errors="strict") for part in handle.read().split(b"\0") if part]
    except (OSError, UnicodeError):
        return []


def proc_parent(pid):
    try:
        fields = open("/proc/%d/stat" % pid, encoding="utf-8").read().rsplit(")", 1)[1].split()
        return int(fields[1])
    except (OSError, IndexError, ValueError):
        return 0


def native_child(managed_pid, thread_id, expected_identity, deadline):
    """Find the guard's actual native CLI descendant and its private cli.sock."""
    while time.monotonic() < deadline:
        children = {}
        try:
            for name in os.listdir("/proc"):
                if name.isdigit():
                    parent = proc_parent(int(name))
                    children.setdefault(parent, []).append(int(name))
        except OSError:
            pass
        pending, seen = list(children.get(managed_pid, [])), set()
        while pending:
            pid = pending.pop()
            if pid in seen: continue
            seen.add(pid); pending.extend(children.get(pid, []))
            argv = proc_argv(pid)
            try:
                executable = os.stat("/proc/%d/exe" % pid)
                if (executable.st_dev, executable.st_ino) != expected_identity: continue
            except OSError: continue
            if len(argv) >= 4 and argv[-2:] == ["resume", thread_id] and "--remote" in argv:
                remote = argv[argv.index("--remote") + 1] if argv.index("--remote") + 1 < len(argv) else ""
                if remote.startswith("unix:///"):
                    sock = remote[len("unix://"):]
                    try:
                        entry = os.lstat(sock)
                        if stat.S_ISSOCK(entry.st_mode) and entry.st_uid == os.getuid() and not (entry.st_mode & 0o077):
                            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                            probe.settimeout(.5); probe.connect(sock)
                            credentials = probe.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12); probe.close()
                            peer_pid = int.from_bytes(credentials[:4], sys.byteorder)
                            if peer_pid <= 1 or not process_descends(peer_pid, managed_pid): continue
                            return pid, proc_start(pid), argv, sock, peer_pid, proc_start(peer_pid)
                    except OSError:
                        pass
        time.sleep(.025)
    raise ValueError("native Codex attachment child was not observed")


def managed_attachment(request, supplied_directory):
    """Load only a server-created, owner-only descriptor; browser fields cannot set argv."""
    filename = request.get("codexAttachFile")
    if not isinstance(filename, str) or not filename.startswith("/") or len(filename) > 4096:
        raise ValueError("invalid Codex attachment descriptor")
    filename = os.path.realpath(filename)
    if not private_regular(filename):
        raise ValueError("invalid Codex attachment descriptor")
    with open(filename, "r", encoding="utf-8") as handle:
        descriptor = json.load(handle)
    if not isinstance(descriptor, dict) or descriptor.get("version") != 1:
        raise ValueError("invalid Codex attachment descriptor")
    private = descriptor.get("attestation")
    if not isinstance(private, dict):
        raise ValueError("invalid Codex attachment descriptor")
    route = private.get("route")
    argv = route.get("managedArgv") if isinstance(route, dict) else None
    thread = private.get("threadId")
    fingerprint = private.get("fingerprint")
    cwd = private.get("cwd")
    receipt_file = descriptor.get("receiptFile")
    receipt = private.get("receipt") if isinstance(private.get("receipt"), dict) else {}
    deployment = route.get("deploymentPath") if isinstance(route, dict) else None
    native_path = receipt.get("nativePath")
    if not isinstance(deployment, str) or not deployment.startswith("/") or native_path != "/proc/%s/exe" % receipt.get("peerPid"):
        raise ValueError("invalid Codex attachment route")
    expected_argv = [os.path.join(deployment, "venv/bin/python"), "-I", "-m", "codex_usage_guard", "managed-cli",
                     "--config", os.path.join(deployment, "etc/enforce.json"), "--native", native_path, "--",
                     "-c", "check_for_update_on_startup=false", "resume", thread]
    if (argv != expected_argv or not all(isinstance(value, str) and value for value in argv)
            or not isinstance(fingerprint, str) or not fingerprint
            or not isinstance(cwd, str) or not cwd.startswith("/") or os.path.realpath(cwd) != os.path.realpath(supplied_directory)
            or not isinstance(receipt_file, str) or not receipt_file.startswith("/")):
        raise ValueError("invalid Codex attachment descriptor")
    receipt_file = os.path.realpath(receipt_file)
    parent = os.path.dirname(receipt_file)
    try:
        parent_stat = os.lstat(parent)
        if not stat.S_ISDIR(parent_stat.st_mode) or stat.S_ISLNK(parent_stat.st_mode) or parent_stat.st_uid != os.getuid() or parent_stat.st_mode & 0o077:
            raise ValueError()
    except OSError as error:
        raise ValueError("invalid Codex attachment receipt") from error
    helper = os.path.join(SCRIPT_DIR, "wmux_codex_attach.py")
    # The route must be inspected a second time directly before its only child
    # is created.  The expected fingerprint binds this launch to catalog proof.
    check = subprocess.run([sys.executable, helper, "attest"], input=json.dumps({
        "socketPath": receipt.get("socket"), "launcherPath": route.get("launcherPath"),
        "deploymentPath": route.get("deploymentPath"), "cwd": cwd, "expectedFingerprint": fingerprint,
        "expectedReceipt": receipt,
    }), text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5, check=False)
    try:
        verified = json.loads(check.stdout)
    except json.JSONDecodeError:
        verified = {}
    if check.returncode != 0 or verified.get("ok") is not True:
        raise ValueError("Codex attachment reattestation failed")
    return argv, cwd, receipt_file, descriptor, fingerprint


def write_attachment_receipt(receipt_file, descriptor, fingerprint, child_pid):
    target = descriptor.get("target") if isinstance(descriptor.get("target"), dict) else {}
    values = {key: target.get(key) for key in ("workspaceId", "tabId", "paneId", "requestId", "threadId", "generation")}
    if not all(isinstance(value, str) and value for value in values.values()):
        raise ValueError("invalid Codex attachment receipt")
    private = descriptor.get("attestation") if isinstance(descriptor.get("attestation"), dict) else {}
    proof = private.get("receipt") if isinstance(private.get("receipt"), dict) else {}
    expected_identity = (proof.get("peerExeDev"), proof.get("peerExeIno"))
    if not all(isinstance(value, int) and not isinstance(value, bool) and value >= 0 for value in expected_identity): raise ValueError("native executable unavailable")
    native_pid, native_start, native_argv, cli_socket, peer_pid, peer_start = native_child(child_pid, values["threadId"], expected_identity, time.monotonic() + 5)
    cli_stat = os.lstat(cli_socket)
    listener_inode = unix_socket_inode(cli_socket)
    native_exe = os.path.realpath("/proc/%d/exe" % native_pid)
    executable = os.stat("/proc/%d/exe" % native_pid)
    if (executable.st_dev, executable.st_ino) != expected_identity or not process_descends(native_pid, child_pid) or not process_descends(peer_pid, child_pid) or not listener_owned_by(peer_pid, listener_inode):
        raise ValueError("native Codex attachment identity was not observed")
    receipt = {**values, "fingerprint": fingerprint, "endpointId": descriptor.get("endpointId"),
               "wrapperPid": os.getpid(), "wrapperStart": proc_start(os.getpid()),
               "managedPid": child_pid, "managedStart": proc_start(child_pid),
               # The managed launcher is the initial native CLI ancestor. The
               # server verifier additionally proves the native descendant.
               "nativePid": native_pid, "nativeStart": native_start, "nativeExe": native_exe, "nativeExeDev": executable.st_dev, "nativeExeIno": executable.st_ino, "nativeArgv": native_argv, "cliSocket": cli_socket,
               "cliSocketDev": cli_stat.st_dev, "cliSocketIno": cli_stat.st_ino, "cliListenerIno": listener_inode, "cliPeerPid": peer_pid, "cliPeerStart": peer_start,
               "managedArgv": private_route_argv(descriptor), "status": "launching"}
    temporary = receipt_file + ".tmp-%d" % os.getpid()
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    try:
        descriptor_stat = os.lstat(receipt_file)
        if not private_regular(receipt_file): raise ValueError("invalid Codex attachment receipt")
        os.unlink(receipt_file)
    except FileNotFoundError:
        pass
    fd = os.open(temporary, flags, 0o600)
    try:
        os.write(fd, json.dumps(receipt, separators=(",", ":")).encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temporary, receipt_file)


def invalidate_attachment_receipt(receipt_file):
    try:
        if not private_regular(receipt_file): return
        receipt = json.load(open(receipt_file, encoding="utf-8"))
        receipt["invalidated"] = True
        temporary = receipt_file + ".input-%d" % os.getpid()
        with open(temporary, "x", encoding="utf-8") as handle:
            os.chmod(temporary, 0o600); json.dump(receipt, handle, separators=(",", ":")); handle.flush(); os.fsync(handle.fileno())
        os.replace(temporary, receipt_file)
    except (OSError, ValueError, json.JSONDecodeError):
        pass


def terminal_reply_only(data):
    """Known terminal capability replies and focus reports are not task input."""
    return bool(re.fullmatch(rb"(?:\x1b\[[IO]|\x1b\[[?>]?[0-9;]*[Rc]|\x1bP>\|libghostty\x1b\\|\x1b\][0-9;]*[^\x1b\x07]*(?:\x07|\x1b\\))+", data))


def private_route_argv(descriptor):
    private = descriptor.get("attestation") if isinstance(descriptor.get("attestation"), dict) else {}
    route = private.get("route") if isinstance(private.get("route"), dict) else {}
    return route.get("managedArgv") if isinstance(route.get("managedArgv"), list) else []


def process_descends(pid, ancestor):
    while pid > 1:
        if pid == ancestor: return True
        pid = proc_parent(pid)
    return False


def listener_owned_by(root, inode):
    pending, seen = [root], set()
    while pending:
        pid = pending.pop()
        if pid in seen: continue
        seen.add(pid)
        try:
            for entry in os.listdir("/proc/%d/fd" % pid):
                try:
                    if os.readlink("/proc/%d/fd/%s" % (pid, entry)) == "socket:[%d]" % inode: return True
                except OSError: pass
        except OSError: pass
        try:
            for name in os.listdir("/proc"):
                if name.isdigit() and proc_parent(int(name)) == pid: pending.append(int(name))
        except OSError: pass
    return False


def unix_socket_inode(pathname):
    for line in open("/proc/net/unix", encoding="utf-8"):
        fields = line.split()
        # A connected accepted socket can share the pathname. Pin only the
        # listening SOCK_STREAM entry (Flags 00010000), whose FD belongs to
        # the guard frontend rather than a transient client connection.
        if len(fields) >= 8 and fields[-1] == pathname and fields[3] == "00010000" and fields[4] == "0001":
            return int(fields[-2])
    raise ValueError("CLI socket inode unavailable")


def validate_codex_remote(remote):
    """Accept only an already-running, private, canonical Unix App Server socket."""
    if os.name == "nt" or not isinstance(remote, str) or len(remote) > 4096:
        raise ValueError("invalid Codex remote")
    if not remote.startswith("unix:///") or any(ord(char) < 32 or ord(char) == 127 for char in remote):
        raise ValueError("invalid Codex remote")
    socket_path = remote[len("unix://"):]
    if (
        not os.path.isabs(socket_path)
        or socket_path.startswith("//")
        or any(character in socket_path for character in "?#")
        or remote != "unix://" + socket_path
    ):
        raise ValueError("invalid Codex remote")
    try:
        resolved = os.path.abspath(socket_path)
        parent = os.path.dirname(resolved)
        socket_stat = os.lstat(resolved)
        parent_stat = os.lstat(parent)
        private_owner = lambda value: value.st_uid == os.getuid() and not (value.st_mode & 0o077)
        if (
            resolved != socket_path
            or os.path.realpath(parent) != parent
            or os.path.realpath(resolved) != resolved
            or not stat.S_ISDIR(parent_stat.st_mode)
            or stat.S_ISLNK(parent_stat.st_mode)
            or not stat.S_ISSOCK(socket_stat.st_mode)
            or stat.S_ISLNK(socket_stat.st_mode)
            or not private_owner(parent_stat)
            or not private_owner(socket_stat)
        ):
            raise ValueError("invalid Codex remote")
    except OSError as error:
        raise ValueError("invalid Codex remote") from error
    return remote


def tui_command_for(request, runtime, directory):
    executable = shutil.which(runtime)
    if not executable:
        raise FileNotFoundError("%s executable not found" % runtime)
    # PATH may contain relative entries. Pin what was selected before changing
    # cwd so a repository-local executable cannot replace it at launch time.
    executable = os.path.realpath(os.path.abspath(executable))
    if not os.path.isabs(executable):
        raise ValueError("%s executable did not resolve to an absolute path" % runtime)
    model = request.get("model")
    argv = [executable]
    if runtime == "prime-agent":
        argv.append("--no-session")
    if runtime == "codex" and any(key in request for key in ("sandboxMode", "writeAccess", "unattended")):
        sandbox_mode = request.get("sandboxMode") or ("workspace-write" if request.get("writeAccess") is True else "read-only")
        argv.extend(["--config", "check_for_update_on_startup=false", "--sandbox", sandbox_mode])
        if request.get("unattended") is True:
            argv.extend(["--ask-for-approval", "never"])
    if runtime == "codex" and request.get("codexRemote"):
        # A remote App Server selects its own working directory unless Codex is
        # told explicitly.  The launcher process cwd only governs this local
        # wrapper, so preserve the validated directory in the remote TUI too.
        argv.extend(["--remote", request["codexRemote"], "--cd", directory])
    if runtime == "opencode" and request.get("agent"):
        argv.extend(["--agent", request["agent"]])
    if model:
        argv.extend(["--model", model])
    return argv


def tui_main(expected_run_id):
    run_id = expected_run_id or "unknown"
    try:
        request = request_from_stdin("%s %s" % (AGENT_TUI_READY, run_id))
        candidate = request.get("runId")
        if not expected_run_id and isinstance(candidate, str) and re.fullmatch(RUN_ID_RE, candidate):
            run_id = candidate
        request_run_id, runtime, _prompt, directory = validate(request, tui=True)
        if expected_run_id and request_run_id != expected_run_id:
            raise ValueError("runId does not match TUI launch marker")
        run_id = request_run_id
        attachment = None
        if request.get("codexAttachFile"):
            argv, directory, receipt_file, descriptor, fingerprint = managed_attachment(request, directory)
            attachment = (receipt_file, descriptor, fingerprint)
        else:
            argv = tui_command_for(request, runtime, directory)
    except FileNotFoundError as error:
        return fail(run_id, str(error), 127)
    except (OSError, ValueError) as error:
        return fail(run_id, str(error))

    ack = "%s %s" % (AGENT_TUI_ACK, run_id)
    try:
        received = control_line("%s %s" % (AGENT_TUI_LAUNCH, run_id))
        if received != ack:
            code = fail(run_id, "invalid interactive controller acknowledgement")
            quarantine_tui(run_id)
            return code
        env = os.environ.copy()
        env["WMUX_INTERACTIVE_TUI"] = "1"
        if attachment:
            receipt_file, descriptor, fingerprint = attachment
            code = supervise_tui(argv, directory, env, lambda child: write_attachment_receipt(receipt_file, descriptor, fingerprint, child.pid), lambda: invalidate_attachment_receipt(receipt_file))
        else:
            code = supervise_tui(argv, directory, env)
    except (OSError, ValueError) as error:
        # Receipt creation is part of the managed launch gate. Do not leave a
        # wrapper running or return raw traceback text to the terminal.
        stop_process_group(locals().get("child"), signal.SIGKILL, 0)
        code = fail(run_id, str(error), 127)
        quarantine_tui(run_id)
        return code
    print("%s %s %d" % (AGENT_TUI_EXIT, run_id, code), flush=True)
    quarantine_tui(run_id)
    return code


class ForwardedSignal(Exception):
    def __init__(self, signum):
        super().__init__(signum)
        self.signum = signum


def process_group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def stop_process_group(child, signum, grace=TERMINATION_GRACE):
    if child is None:
        return
    if os.name == "nt":
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=grace)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        return
    pgid = child.pid
    if process_group_alive(pgid):
        try:
            os.killpg(pgid, signum)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + grace
    while process_group_alive(pgid) and time.monotonic() < deadline:
        remaining = max(0.0, deadline - time.monotonic())
        if child.poll() is None:
            try:
                child.wait(timeout=min(0.05, remaining))
            except subprocess.TimeoutExpired:
                pass
        else:
            time.sleep(min(0.05, remaining))
    if process_group_alive(pgid):
        try:
            os.killpg(pgid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    if child.poll() is None:
        child.wait()


def control_line(marker):
    tty_state = None
    if sys.stdin.isatty():
        import termios

        tty_state = termios.tcgetattr(sys.stdin.fileno())
        quiet = termios.tcgetattr(sys.stdin.fileno())
        quiet[3] &= ~termios.ECHO
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, quiet)
    try:
        print(marker, flush=True)
        line = sys.stdin.buffer.readline(MAX_LINE + 1)
    finally:
        if tty_state is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, tty_state)
    if len(line) > MAX_LINE:
        return ""
    return line.rstrip(b"\r\n").decode("ascii", errors="replace")


def supervise_tui(argv, directory, env, on_started=None, on_input=None):
    child = None
    master = slave = None
    previous_handlers = {}
    tty_fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    parent_pgrp = os.getpgrp()
    tty_state = None
    previous_sigttou = None
    termination_signals = {signal.SIGTERM, signal.SIGHUP}
    previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, termination_signals)
    mask_restored = False

    def forward_signal(signum, _frame):
        raise ForwardedSignal(signum)

    def prepare_child():
        os.setpgrp()
        for signum in termination_signals:
            signal.signal(signum, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)

    try:
        if tty_fd is not None:
            import termios

            tty_state = termios.tcgetattr(tty_fd)
        for signum in termination_signals:
            previous_handlers[signum] = signal.signal(signum, forward_signal)
        master = slave = None
        if on_input is not None and tty_fd is not None:
            import pty
            import tty

            master, slave = pty.openpty()
            def prepare_attachment_child():
                os.setsid()
                import fcntl
                import termios
                fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
                for signum in termination_signals: signal.signal(signum, signal.SIG_DFL)
                signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
            child = subprocess.Popen(argv, cwd=directory, env=env, stdin=slave, stdout=slave, stderr=slave, preexec_fn=prepare_attachment_child)
            os.close(slave); slave = None
        else:
            child = subprocess.Popen(argv, cwd=directory, env=env, preexec_fn=prepare_child)
        if on_started is not None:
            on_started(child)
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        mask_restored = True
        if tty_fd is not None and master is None:
            previous_sigttou = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
            try:
                os.tcsetpgrp(tty_fd, child.pid)
            except OSError:
                if child.poll() is None:
                    raise
        if master is not None:
            # The outer terminal must be raw too: the child owns a separate
            # slave PTY, so canonical outer input would otherwise line-buffer
            # keystrokes and echo them outside the TUI.
            outer_state = termios.tcgetattr(tty_fd)
            tty.setraw(tty_fd)
            import fcntl
            try: fcntl.ioctl(master, termios.TIOCSWINSZ, fcntl.ioctl(tty_fd, termios.TIOCGWINSZ, b"\0" * 8))
            except OSError: pass
            previous_winch = signal.getsignal(signal.SIGWINCH)
            def resize(_signum, _frame):
                try: fcntl.ioctl(master, termios.TIOCSWINSZ, fcntl.ioctl(tty_fd, termios.TIOCGWINSZ, b"\0" * 8))
                except OSError: pass
            signal.signal(signal.SIGWINCH, resize)
            os.set_blocking(master, False)
            selector = selectors.DefaultSelector(); selector.register(master, selectors.EVENT_READ); selector.register(tty_fd, selectors.EVENT_READ)
            invalidated = False
            pending_input = bytearray()
            master_open = True
            while master_open:
                exited = child.poll() is not None
                events = selector.select(0 if exited else .05)
                if exited and not events:
                    break
                for key, mask in events:
                    if key.fileobj == master and mask & selectors.EVENT_WRITE:
                        try:
                            written = os.write(master, pending_input)
                            del pending_input[:written]
                        except BlockingIOError:
                            pass
                        if not pending_input:
                            selector.modify(master, selectors.EVENT_READ)
                            selector.register(tty_fd, selectors.EVENT_READ)
                    if not mask & selectors.EVENT_READ:
                        continue
                    try: chunk = os.read(key.fileobj, 8192)
                    except BlockingIOError: continue
                    except OSError: chunk = b""
                    if key.fileobj == tty_fd:
                        if chunk:
                            if not invalidated and not terminal_reply_only(chunk): on_input(); invalidated = True
                            # Stop reading the outer PTY until this bounded chunk
                            # drains. A busy child must not truncate a paste or
                            # turn EAGAIN into termination of the managed view.
                            pending_input.extend(chunk)
                            selector.unregister(tty_fd)
                            selector.modify(master, selectors.EVENT_READ | selectors.EVENT_WRITE)
                        else: selector.unregister(tty_fd)
                    elif chunk:
                        os.write(sys.stdout.fileno(), chunk)
                    else:
                        selector.unregister(master)
                        master_open = False
            selector.close(); os.close(master); master = None
            signal.signal(signal.SIGWINCH, previous_winch)
            termios.tcsetattr(tty_fd, termios.TCSADRAIN, outer_state)
        code = child.wait()
        return 128 - code if code < 0 else code
    except KeyboardInterrupt:
        stop_process_group(child, signal.SIGINT)
        return 130
    except ForwardedSignal as forwarded:
        stop_process_group(child, forwarded.signum)
        return 128 + forwarded.signum
    except (OSError, ValueError):
        stop_process_group(child, signal.SIGKILL, 0)
        if master is not None:
            # Startup attestation precedes the relay. Preserve the child's
            # actual error instead of replacing it with a generic timeout.
            os.set_blocking(master, False)
            remaining = 64 * 1024
            while remaining > 0:
                try: chunk = os.read(master, min(8192, remaining))
                except OSError: break
                if not chunk: break
                os.write(sys.stdout.fileno(), chunk); remaining -= len(chunk)
        raise
    finally:
        if master is not None: os.close(master)
        if slave is not None: os.close(slave)
        for signum, previous in previous_handlers.items():
            signal.signal(signum, previous)
        if not mask_restored:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        if tty_fd is not None:
            try:
                os.tcsetpgrp(tty_fd, parent_pgrp)
            except OSError:
                pass
            if tty_state is not None:
                import termios

                termios.tcsetattr(tty_fd, termios.TCSADRAIN, tty_state)
            if previous_sigttou is not None:
                signal.signal(signal.SIGTTOU, previous_sigttou)


def quarantine_tui(run_id):
    release = ("%s %s" % (AGENT_TUI_RELEASE, run_id)).encode("ascii")
    tty_state = None
    if sys.stdin.isatty():
        import termios

        tty_state = termios.tcgetattr(sys.stdin.fileno())
        quiet = termios.tcgetattr(sys.stdin.fileno())
        quiet[3] &= ~termios.ECHO
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, quiet)
    try:
        print(
            "Interactive runtime exited; press Ctrl-C to return to the shell "
            "or enter %s %s." % (AGENT_TUI_RELEASE, run_id),
            flush=True,
        )
        while True:
            try:
                line = sys.stdin.buffer.readline(MAX_LINE + 1)
            except KeyboardInterrupt:
                return
            if not line:
                time.sleep(0.1)
                continue
            if len(line) <= MAX_LINE and line.rstrip(b"\r\n") == release:
                return
    finally:
        if tty_state is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, tty_state)
            print(flush=True)


def advertised_option(output, option):
    return re.search(r"(?:^|[\s[,])" + re.escape(option) + r"(?=$|[\s=,\]])", output, flags=re.MULTILINE) is not None


def opencode_auto_option(executable, env):
    child = None
    selector = selectors.DefaultSelector()
    captured = bytearray()
    try:
        child = subprocess.Popen(
            [executable, "run", "--help"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=env,
            start_new_session=True,
        )
        assert child.stdout is not None
        os.set_blocking(child.stdout.fileno(), False)
        selector.register(child.stdout, selectors.EVENT_READ)
        deadline = time.monotonic() + HELP_PROBE_TIMEOUT
        eof = False
        while not eof or child.poll() is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                stop_process_group(child, signal.SIGKILL, 0)
                raise ValueError("OpenCode auto-approval capability probe timed out")
            for key, _events in selector.select(min(0.05, remaining)):
                try:
                    chunk = os.read(key.fileobj.fileno(), 8192)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    eof = True
                    continue
                available = MAX_HELP_OUTPUT - len(captured)
                if available > 0:
                    captured.extend(chunk[:available])
        code = child.wait()
    except OSError as error:
        stop_process_group(child, signal.SIGKILL, 0)
        raise ValueError("OpenCode auto-approval capability probe failed") from error
    finally:
        selector.close()
    if code != 0:
        raise ValueError("OpenCode auto-approval capability probe failed")
    output = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", captured.decode("utf-8", errors="replace"))
    if advertised_option(output, "--auto"):
        return "--auto"
    if advertised_option(output, "--dangerously-skip-permissions"):
        return "--dangerously-skip-permissions"
    raise ValueError("installed OpenCode does not advertise an auto-approval option")


def command_for(request, runtime, directory, env, schema_path=None):
    executable = shutil.which(runtime)
    if not executable:
        raise FileNotFoundError("%s executable not found" % runtime)
    unattended = request.get("unattended") is True
    write_access = request.get("writeAccess", False) is True
    model = request.get("model")
    if runtime == "opencode":
        if not write_access:
            raise ValueError("OpenCode delegation cannot enforce read-only mode; explicitly enable writeAccess")
        argv = [executable, "run", "--format", "json", "--dir", directory]
        if request.get("title"):
            argv.extend(["--title", request["title"]])
        if request.get("agent"):
            argv.extend(["--agent", request["agent"]])
        if model:
            argv.extend(["--model", model])
        if unattended:
            argv.append(opencode_auto_option(executable, env))
        return argv, None
    if runtime == "codex":
        sandbox_mode = request.get("sandboxMode") or ("workspace-write" if write_access else "read-only")
        argv = [executable, "--sandbox", sandbox_mode]
        if unattended:
            argv.extend(["--ask-for-approval", "never"])
        if model:
            argv.extend(["--model", model])
        argv.extend(["exec", "--json", "-C", directory])
        if schema_path:
            argv.extend(["--output-schema", schema_path])
        argv.append("-")
        return argv, None
    if runtime == "prime-agent":
        if not write_access:
            raise ValueError("Prime Agent delegation cannot enforce read-only mode; explicitly enable writeAccess")
        if not unattended:
            raise ValueError("Prime Agent delegation has no approval prompts; explicitly enable unattended")
        argv = [executable, "--print", "--mode", "json", "--no-session", "--cwd", directory]
        if model:
            argv.extend(["--model", model])
        return argv, None
    argv = [executable, "-p", "--verbose", "--input-format", "text", "--output-format", "stream-json"]
    argv.extend(["--permission-mode", "acceptEdits" if write_access else "plan"])
    if unattended:
        argv.append("--dangerously-skip-permissions")
    if model:
        argv.extend(["--model", model])
    return argv, directory


def prepare_windows_command(argv, platform=None, exists=None, which=None):
    platform = os.name if platform is None else platform
    exists = os.path.isfile if exists is None else exists
    which = shutil.which if which is None else which
    if platform != "nt" or os.path.splitext(argv[0])[1].lower() not in {".bat", ".cmd"}:
        return argv, False
    powershell_script = os.path.splitext(argv[0])[0] + ".ps1"
    powershell = which("pwsh") or which("powershell")
    if powershell and exists(powershell_script):
        return [
            powershell,
            "-NoLogo",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            powershell_script,
            *argv[1:],
        ], False
    return argv, True


def nested_text(value):
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return "\n".join(filter(None, (nested_text(item) for item in value)))
    if not isinstance(value, dict):
        return ""
    for key in ("text", "message", "error", "errorMessage", "data", "part", "content"):
        nested = nested_text(value.get(key))
        if nested:
            return nested
    return ""


def parse_event(runtime, parsed):
    if not isinstance(parsed, dict):
        return "", ""
    kind = parsed.get("type")
    if runtime == "opencode":
        if kind == "text":
            return nested_text(parsed.get("part")) or nested_text(parsed.get("text")), ""
        if kind == "error":
            return "", nested_text(parsed.get("error")) or nested_text(parsed)
    elif runtime == "codex":
        item = parsed.get("item")
        if kind == "item.completed" and isinstance(item, dict) and item.get("type") == "agent_message":
            return nested_text(item), ""
        if kind in {"error", "turn.failed"}:
            return "", nested_text(parsed)
    elif runtime == "prime-agent":
        message = parsed.get("message")
        if kind == "message_end" and isinstance(message, dict) and message.get("role") == "assistant":
            text = nested_text(message.get("content"))
            if message.get("stopReason") in {"error", "aborted"}:
                return "", nested_text(message.get("errorMessage")) or text or "Prime Agent failed"
            return text, ""
        if kind == "error":
            return "", nested_text(parsed)
    elif kind == "result":
        text = nested_text(parsed.get("result"))
        if parsed.get("is_error") is True or parsed.get("subtype") not in {None, "success"}:
            return "", text or nested_text(parsed)
        return text, ""
    return "", ""


def parse_structured_outcome(value):
    try:
        parsed = json.loads(value)
    except (TypeError, json.JSONDecodeError) as error:
        raise ValueError("Codex did not return the required structured outcome") from error
    if not isinstance(parsed, dict):
        raise ValueError("Codex did not return the required structured outcome")
    outcome, summary = parsed.get("outcome"), parsed.get("summary")
    if outcome not in {"completed", "blocked", "failed"} or not isinstance(summary, str) or not summary.strip():
        raise ValueError("Codex returned an invalid structured outcome")
    return outcome, summary.strip()


def main():
    if len(sys.argv) in {2, 3} and sys.argv[1] == "tui":
        expected = sys.argv[2] if len(sys.argv) == 3 else ""
        if expected and not re.fullmatch(RUN_ID_RE, expected):
            return fail("unknown", "invalid TUI runId")
        return tui_main(expected)
    expected_run_id = ""
    if len(sys.argv) == 3 and sys.argv[1] == "request":
        expected_run_id = sys.argv[2]
        if not re.fullmatch(RUN_ID_RE, expected_run_id):
            return fail("unknown", "invalid request runId")
    elif len(sys.argv) != 1:
        return fail("unknown", "usage: wmux-agent-run [request RUN_ID|tui RUN_ID]")
    run_id = expected_run_id or "unknown"
    schema_path = None
    try:
        marker = "%s %s" % (AGENT_READY, expected_run_id) if expected_run_id else AGENT_READY
        request = request_from_stdin(marker)
        candidate = request.get("runId")
        if isinstance(candidate, str) and re.fullmatch(RUN_ID_RE, candidate):
            run_id = candidate
        if expected_run_id and candidate != expected_run_id:
            raise ValueError("request runId does not match the launched helper")
        run_id, runtime, prompt, directory = validate(request)
        env = os.environ.copy()
        env["WMUX_DELEGATED_RUN"] = "1"
        env["WMUX_DELEGATION_RUN_ID"] = run_id
        if request.get("resultFormat") == "outcome-v1":
            descriptor, schema_path = tempfile.mkstemp(prefix="wmux-agent-outcome-", suffix=".json")
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                json.dump(OUTCOME_SCHEMA, handle, separators=(",", ":"))
            if os.name != "nt":
                os.chmod(schema_path, 0o600)
        argv, cwd = command_for(request, runtime, directory, env, schema_path)
        argv, use_shell = prepare_windows_command(argv)
    except FileNotFoundError as error:
        if schema_path:
            try:
                os.unlink(schema_path)
            except OSError:
                pass
        return fail(run_id, str(error), 127)
    except ValueError as error:
        if schema_path:
            try:
                os.unlink(schema_path)
            except OSError:
                pass
        return fail(run_id, str(error))

    result, error, last_text = "", "", ""
    prompt_forms = {prompt, json.dumps(prompt, ensure_ascii=False)[1:-1], json.dumps(prompt)[1:-1]}
    child = None
    previous_handlers = {}

    def forward_signal(signum, _frame):
        raise ForwardedSignal(signum)

    forwarded_signals = tuple(
        candidate for candidate in (getattr(signal, "SIGTERM", None), getattr(signal, "SIGHUP", None))
        if candidate is not None
    )
    for signum in forwarded_signals:
        previous_handlers[signum] = signal.signal(signum, forward_signal)
    try:
        child = subprocess.Popen(
            argv,
            cwd=cwd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            env=env,
            shell=use_shell,
            start_new_session=os.name != "nt",
            creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if os.name == "nt" else 0,
        )
        assert child.stdin is not None and child.stdout is not None
        child.stdin.write(prompt)
        child.stdin.close()
        for line in child.stdout:
            visible = line
            for prompt_form in prompt_forms:
                if prompt_form:
                    visible = visible.replace(prompt_form, "[redacted]")
            sys.stdout.write(visible)
            sys.stdout.flush()
            try:
                parsed = json.loads(line)
            except json.JSONDecodeError:
                continue
            text, failure = parse_event(runtime, parsed)
            if text:
                result = append_bounded(result, text)
                last_text = text
            if failure:
                error = append_bounded(error, failure)
        code = child.wait()
    except KeyboardInterrupt:
        stop_process_group(child, signal.SIGINT)
        return fail(run_id, "cancelled by Ctrl-C", 130)
    except ForwardedSignal as forwarded:
        stop_process_group(child, forwarded.signum)
        return 128 + forwarded.signum
    except OSError as exc:
        stop_process_group(child, getattr(signal, "SIGKILL", signal.SIGTERM), 0)
        return fail(run_id, str(exc), 127)
    finally:
        for signum, previous in previous_handlers.items():
            signal.signal(signum, previous)
        if schema_path:
            try:
                os.unlink(schema_path)
            except OSError:
                pass
    outcome = "completed"
    if request.get("resultFormat") == "outcome-v1" and not error:
        try:
            outcome, result = parse_structured_outcome(last_text)
        except ValueError as exc:
            outcome, error = "failed", str(exc)
    elif code != 0 or error:
        outcome = "failed"
    ok = code == 0 and not error and outcome == "completed"
    if outcome != "completed" and not error:
        error = result
    payload = {
        "runId": run_id,
        "runtime": runtime,
        "ok": ok,
        "result": bounded(result),
        "error": bounded(error),
    }
    if request.get("resultFormat") == "outcome-v1":
        payload["outcome"] = outcome
    emit(AGENT_RESULT, payload)
    print("%s %s %d" % (AGENT_DONE, run_id, code), flush=True)
    return code


if __name__ == "__main__":
    sys.exit(main())
