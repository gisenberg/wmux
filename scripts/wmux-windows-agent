sys.path.insert(0, _PROTOCOL_SEARCH_ROOT)
sys.path.insert(0, os.path.join(_PROTOCOL_SEARCH_ROOT, "windows"))

from wmux_windows_agent_protocol import (
    WINDOWS_AGENT_CAPABILITIES,
    WINDOWS_AGENT_DRAIN_PATH,
    WINDOWS_AGENT_HEALTH_PATH,
    WINDOWS_AGENT_LONG_POLL_DEFAULT_MS,
    WINDOWS_AGENT_LONG_POLL_MAXIMUM_MS,
    WINDOWS_AGENT_PROTOCOL_VERSION,
    WINDOWS_AGENT_SESSIONS_PATH,
)


RELEASE_VERSION = "__WMUX_WINDOWS_AGENT_RELEASE_VERSION__"
PROTOCOL_VERSION = WINDOWS_AGENT_PROTOCOL_VERSION
DEFAULT_REPLAY_BYTES = 2 * 1024 * 1024
MAX_PASTE_IMAGE_BYTES = 8 * 1024 * 1024
PASTE_IMAGE_TTL_SECONDS = 60 * 60
BACKEND_CONPTY = "conpty"
BACKEND_STDIO = "stdio"
BACKEND_PTY = "pty"

LOCAL_TERMINAL_QUERY_RESPONSES = {
    b"\x1b[c": b"\x1b[?62;22c",
    b"\x1b[0c": b"\x1b[?62;22c",
    b"\x1b[5n": b"\x1b[0n",
}

OSC_DEFAULT_COLOR_RESPONSE_PATTERN = re.compile(
    rb"\x1b\](10|11);rgb:[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}(?:\x07|\x1b\\)"
)

TERMINAL_RESPONSE_RECORD_PATTERN = re.compile(
    rb"(?:"
    rb"\x1b\[[?>]?[0-9;]*c"
    rb"|\x1b\[(?:0n|\??[0-9]+;[0-9]+R)"
    rb"|\x1b\[(?:[12]|(?:3|4|6|8|9);[0-9]+;[0-9]+)t"
    rb"|\x1bP>\|libghostty(?: [ -~]{1,64})?\x1b\\"
    rb"|\x1b\](?:10|11);rgb:[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}(?:\x07|\x1b\\)"
    rb"|\x1b\]4;[0-9]{1,3};rgb:[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}"
    rb"(?:;[0-9]{1,3};rgb:[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4}/[0-9a-fA-F]{1,4})*(?:\x07|\x1b\\)"
    rb")"
)

OSC7_PATTERN = re.compile(rb"\x1b\]7;file://([^\x07\x1b]*)(?:\x07|\x1b\\)")

JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE = 0x00002000
JOB_OBJECT_EXTENDED_LIMIT_INFORMATION = 9
PROCESS_TERMINATE = 0x0001
PROCESS_SET_QUOTA = 0x0100
AGENT_RESTART_EXIT_CODE = 75
DEFAULT_HEARTBEAT_INTERVAL_SECONDS = 30
DEFAULT_HEARTBEAT_TIMEOUT_SECONDS = 15
DEFAULT_STREAM_RESTART_MAX_SECONDS = 30
POSIX_RUNTIME_FILE_CAPABILITY = "posix-runtime-files-v1"
CONSOLE_SCREEN_CAPABILITY = "console-screen-v1"


def agent_capability_available(capability: str, backend: str) -> bool:
    if capability == POSIX_RUNTIME_FILE_CAPABILITY:
        return os.name != "nt"
    if capability == CONSOLE_SCREEN_CAPABILITY:
        return os.name == "nt" and backend == BACKEND_CONPTY
    return True


def agent_program_name() -> str:
    return "wmux-windows-agent" if os.name == "nt" else "wmux-session-agent"


class AgentDrainingError(RuntimeError):
    pass


class HeartbeatNotConfigured(RuntimeError):
    pass


def paste_image_root(config: dict[str, Any]) -> str:
    configured = config_string(config, "pasteImageDir")
    if configured:
        return os.path.abspath(os.path.expandvars(configured))
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA") or os.path.join(os.path.expanduser("~"), "AppData", "Local")
    else:
        base = os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("TMPDIR") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.abspath(os.path.join(base, "wmux", "paste-images"))


def paste_image_prefix(session_id: str, stage_id: str) -> str:
    pane_digest = hashlib.sha256(session_id.encode("utf-8")).hexdigest()[:24]
    return f"{pane_digest}-{stage_id}"


def sweep_paste_images(config: dict[str, Any]) -> None:
    root = paste_image_root(config)
    if not os.path.isdir(root):
        return
    cutoff = time.time() - PASTE_IMAGE_TTL_SECONDS
    for name in os.listdir(root):
        if not re.fullmatch(r"[0-9a-f]{24}-paste-[0-9a-f]{36}\.(png|jpg|webp|gif)", name):
            continue
        target = os.path.join(root, name)
        try:
            if os.path.isfile(target) and os.path.getmtime(target) < cutoff:
                os.remove(target)
        except OSError:
            pass


def validate_paste_image(data: bytes, extension: str) -> bool:
    if extension == "png":
        return data.startswith(b"\x89PNG\r\n\x1a\n")
    if extension == "jpg":
        return data.startswith(b"\xff\xd8\xff")
    if extension == "gif":
        return data.startswith((b"GIF87a", b"GIF89a"))
    if extension == "webp":
        return len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP"
    return False


def stage_paste_image(
    config: dict[str, Any], session_id: str, stage_id: str, extension: str, data: bytes
) -> dict[str, Any]:
    if not re.fullmatch(r"paste-[0-9a-f]{36}", stage_id) or extension not in ("png", "jpg", "webp", "gif"):
        raise ValueError("invalid_stage")
    if not data or len(data) > MAX_PASTE_IMAGE_BYTES or not validate_paste_image(data, extension):
        raise ValueError("invalid_image")
    root = paste_image_root(config)
    os.makedirs(root, mode=0o700, exist_ok=True)
    try:
        os.chmod(root, 0o700)
    except OSError:
        pass
    sweep_paste_images(config)
    target = os.path.join(root, f"{paste_image_prefix(session_id, stage_id)}.{extension}")
    descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        try:
            os.remove(target)
        except OSError:
            pass
        raise
    try:
        os.chmod(target, 0o600)
    except OSError:
        pass
    return {
        "stageId": stage_id,
        "targetPath": target,
        "bytes": len(data),
        "expiresAt": int((time.time() + PASTE_IMAGE_TTL_SECONDS) * 1000),
    }


def delete_paste_image(config: dict[str, Any], session_id: str, stage_id: str) -> bool:
    root = paste_image_root(config)
    if not os.path.isdir(root) or not re.fullmatch(r"paste-[0-9a-f]{36}", stage_id):
        return False
    prefix = paste_image_prefix(session_id, stage_id) + "."
    removed = False
    for name in os.listdir(root):
        if not name.startswith(prefix):
            continue
        try:
            os.remove(os.path.join(root, name))
            removed = True
        except OSError:
            pass
    return removed


def delete_session_paste_images(config: dict[str, Any], session_id: str) -> None:
    root = paste_image_root(config)
    if not os.path.isdir(root):
        return
    prefix = hashlib.sha256(session_id.encode("utf-8")).hexdigest()[:24] + "-paste-"
    for name in os.listdir(root):
        if name.startswith(prefix):
            try:
                os.remove(os.path.join(root, name))
            except OSError:
                pass


class WindowsJobApi:
    def __init__(self) -> None:
        if os.name != "nt":
            raise RuntimeError("Windows Job Objects are only available on Windows")
        from ctypes import wintypes

        class JobObjectBasicLimitInformation(ctypes.Structure):
            _fields_ = [
                ("PerProcessUserTimeLimit", ctypes.c_int64),
                ("PerJobUserTimeLimit", ctypes.c_int64),
                ("LimitFlags", wintypes.DWORD),
                ("MinimumWorkingSetSize", ctypes.c_size_t),
                ("MaximumWorkingSetSize", ctypes.c_size_t),
                ("ActiveProcessLimit", wintypes.DWORD),
                ("Affinity", ctypes.c_size_t),
                ("PriorityClass", wintypes.DWORD),
                ("SchedulingClass", wintypes.DWORD),
            ]

        class IoCounters(ctypes.Structure):
            _fields_ = [
                ("ReadOperationCount", ctypes.c_uint64),
                ("WriteOperationCount", ctypes.c_uint64),
                ("OtherOperationCount", ctypes.c_uint64),
                ("ReadTransferCount", ctypes.c_uint64),
                ("WriteTransferCount", ctypes.c_uint64),
                ("OtherTransferCount", ctypes.c_uint64),
            ]

        class JobObjectExtendedLimitInformation(ctypes.Structure):
            _fields_ = [
                ("BasicLimitInformation", JobObjectBasicLimitInformation),
                ("IoInfo", IoCounters),
                ("ProcessMemoryLimit", ctypes.c_size_t),
                ("JobMemoryLimit", ctypes.c_size_t),
                ("PeakProcessMemoryUsed", ctypes.c_size_t),
                ("PeakJobMemoryUsed", ctypes.c_size_t),
            ]

        self.extended_limit_type = JobObjectExtendedLimitInformation
        self.kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        self.kernel32.CreateJobObjectW.argtypes = [ctypes.c_void_p, wintypes.LPCWSTR]
        self.kernel32.CreateJobObjectW.restype = wintypes.HANDLE
        self.kernel32.SetInformationJobObject.argtypes = [
            wintypes.HANDLE,
            ctypes.c_int,
            ctypes.c_void_p,
            wintypes.DWORD,
        ]
        self.kernel32.SetInformationJobObject.restype = wintypes.BOOL
        self.kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        self.kernel32.OpenProcess.restype = wintypes.HANDLE
        self.kernel32.AssignProcessToJobObject.argtypes = [wintypes.HANDLE, wintypes.HANDLE]
        self.kernel32.AssignProcessToJobObject.restype = wintypes.BOOL
        self.kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
        self.kernel32.CloseHandle.restype = wintypes.BOOL

    def create_kill_on_close_job(self) -> Any:
        handle = self.kernel32.CreateJobObjectW(None, None)
        if not handle:
            raise ctypes.WinError(ctypes.get_last_error())
        info = self.extended_limit_type()
        info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
        if not self.kernel32.SetInformationJobObject(
            handle,
            JOB_OBJECT_EXTENDED_LIMIT_INFORMATION,
            ctypes.byref(info),
            ctypes.sizeof(info),
        ):
            error = ctypes.get_last_error()
            self.kernel32.CloseHandle(handle)
            raise ctypes.WinError(error)
        return handle

    def assign_process(self, job_handle: Any, pid: int) -> None:
        process_handle = self.kernel32.OpenProcess(PROCESS_TERMINATE | PROCESS_SET_QUOTA, False, pid)
        if not process_handle:
            raise ctypes.WinError(ctypes.get_last_error())
        try:
            if not self.kernel32.AssignProcessToJobObject(job_handle, process_handle):
                raise ctypes.WinError(ctypes.get_last_error())
        finally:
            self.kernel32.CloseHandle(process_handle)

    def close(self, handle: Any) -> None:
        if not self.kernel32.CloseHandle(handle):
            raise ctypes.WinError(ctypes.get_last_error())


class WindowsProcessTree:
    def __init__(self, pid: int, api: Any | None = None) -> None:
        self.api = api or WindowsJobApi()
        self.lock = threading.Lock()
        self.handle = self.api.create_kill_on_close_job()
        try:
            self.api.assign_process(self.handle, pid)
        except Exception:
            self.api.close(self.handle)
            self.handle = None
            raise

    def terminate(self) -> None:
        with self.lock:
            handle = self.handle
            if handle is None:
                return
            self.api.close(handle)
            self.handle = None


class CwdReporter:
    def __init__(self) -> None:
        self.pending = b""

    def feed(self, data: bytes) -> list[str]:
        combined = self.pending + data
        pending_start = combined.rfind(b"\x1b]7;")
        searchable = combined
        self.pending = b""
        if pending_start >= 0:
            tail = combined[pending_start:]
            if b"\x07" not in tail and b"\x1b\\" not in tail:
                searchable = combined[:pending_start]
                self.pending = tail[-8192:]

        values: list[str] = []
        for match in OSC7_PATTERN.finditer(searchable):
            raw = match.group(1).decode("utf-8", errors="replace")
            slash = raw.find("/")
            if slash < 0:
                continue
            path = unquote(raw[slash:])
            if re.match(r"^/[A-Za-z]:[\\/]", path):
                path = path[1:]
            if len(path) > 4096 or re.search(r"[\x00-\x1f\x7f]", path):
                continue
            if re.match(r"^[A-Za-z]:[\\/]", path) or path.startswith("/"):
                values.append(path)
        return values


def osc_default_color_response(slot: int, color: str) -> bytes | None:
    match = re.fullmatch(r"#([0-9a-fA-F]{6})", color)
    if not match:
        return None
    value = match.group(1).lower()
    red, green, blue = value[0:2], value[2:4], value[4:6]
    return f"\x1b]{slot};rgb:{red}{red}/{green}{green}/{blue}{blue}\x1b\\".encode("ascii")


def local_terminal_query_responses(environment: dict[str, str]) -> dict[bytes, bytes]:
    responses = dict(LOCAL_TERMINAL_QUERY_RESPONSES)
    for slot, key in (
        (10, "WMUX_TERMINAL_FOREGROUND"),
        (11, "WMUX_TERMINAL_BACKGROUND"),
    ):
        reply = osc_default_color_response(slot, environment.get(key, ""))
        if reply is None:
            continue
        for terminator in (b"\x07", b"\x1b\\"):
            responses[f"\x1b]{slot};?".encode("ascii") + terminator] = reply
    return responses


class TerminalQueryResponder:
    def __init__(self, responses: dict[bytes, bytes] | None = None) -> None:
        self.pending = b""
        self.responses = responses if responses is not None else LOCAL_TERMINAL_QUERY_RESPONSES
        self.default_color_slots = {
            slot
            for slot in (b"10", b"11")
            if any(query.startswith(b"\x1b]" + slot + b";?") for query in self.responses)
        }

    def feed(self, data: bytes) -> list[bytes]:
        replies: list[bytes] = []
        queries = tuple(self.responses)
        for value in data:
            self.pending += bytes((value,))
            while self.pending and not any(query.startswith(self.pending) for query in queries):
                self.pending = self.pending[1:]
            reply = self.responses.get(self.pending)
            if reply is not None:
                replies.append(reply)
                self.pending = b""
        return replies

    def owns_response(self, data: bytes) -> bool:
        match = OSC_DEFAULT_COLOR_RESPONSE_PATTERN.fullmatch(data)
        return match is not None and match.group(1) in self.default_color_slots


def split_terminal_response_records(data: bytes) -> list[bytes] | None:
    # Browser terminals may coalesce several generated replies into one input
    # event. Split only when the entire payload consists of reply forms shared
    # with src/shared/terminal-protocol.ts; otherwise preserve it byte-for-byte.
    records: list[bytes] = []
    offset = 0
    while offset < len(data):
        match = TERMINAL_RESPONSE_RECORD_PATTERN.match(data, offset)
        if match is None:
            return None
        records.append(match.group(0))
        offset = match.end()
    return records


def load_config(path: str) -> dict[str, Any]:
    expanded = os.path.expanduser(path)
    if not os.path.isfile(expanded):
        return {}
    with open(expanded, "r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise SystemExit(f"{agent_program_name()}: config must be a JSON object: {expanded}")
    return value


def config_string(config: dict[str, Any], key: str, fallback: str = "") -> str:
    value = config.get(key)
    return value if isinstance(value, str) else fallback


def config_int(config: dict[str, Any], key: str, fallback: int) -> int:
    value = config.get(key)
    if isinstance(value, int):
        return value
    if isinstance(value, str):
        try:
            return int(value)
        except ValueError:
            return fallback
    return fallback


def config_bool(config: dict[str, Any], key: str, fallback: bool) -> bool:
    value = config.get(key)
    return value if isinstance(value, bool) else fallback


def utc_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def read_trimmed_file(path: str) -> str:
    if not os.path.isfile(path):
        return ""
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read().strip()


class RegistrationHeartbeat:
    def __init__(self, agent_config: dict[str, Any], agent_config_path: str, agent_port: int):
        self.agent_config = agent_config
        self.agent_port = agent_port
        configured_state_dir = config_string(agent_config, "stateDir")
        default_state_dir = os.path.dirname(os.path.abspath(os.path.expanduser(agent_config_path)))
        self.state_dir = os.path.abspath(
            os.path.expanduser(
                os.path.expandvars(os.environ.get("WMUX_STATE_DIR") or configured_state_dir or default_state_dir)
            )
        )
        self.owner = config_bool(agent_config, "heartbeatOwner", True)
        self.enabled = config_bool(agent_config, "heartbeatEnabled", True)
        self.interval_seconds = max(
            5,
            config_int(agent_config, "heartbeatIntervalSeconds", DEFAULT_HEARTBEAT_INTERVAL_SECONDS),
        )
        self.timeout_seconds = max(
            1,
            min(60, config_int(agent_config, "heartbeatTimeoutSeconds", DEFAULT_HEARTBEAT_TIMEOUT_SECONDS)),
        )
        self.lock = threading.Lock()
        self.stop_event = threading.Event()
        self.thread: threading.Thread | None = None
        self.status: dict[str, Any] = {
            "owner": self.owner,
            "enabled": self.enabled,
            "configured": False,
            "intervalSeconds": self.interval_seconds,
            "lastAttemptAt": None,
            "lastSuccessAt": None,
            "lastFailureAt": None,
            "consecutiveFailures": 0,
            "lastError": None,
        }

    def snapshot(self) -> dict[str, Any]:
        with self.lock:
            return dict(self.status)

    def start(self) -> None:
        if not self.owner or not self.enabled or self.thread:
            return
        self.thread = threading.Thread(target=self._run, name="wmux-registration-heartbeat", daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()
        if self.thread and self.thread.is_alive():
            self.thread.join(timeout=1.0)

    def _run(self) -> None:
        while not self.stop_event.is_set():
            try:
                self.send_once()
            except Exception as error:
                self._record_failure(f"registration heartbeat failed unexpectedly: {error}")
            self.stop_event.wait(self.interval_seconds)

    def _registration_request(self) -> tuple[str, str, bytes]:
        wmux_url = os.environ.get("WMUX_URL") or read_trimmed_file(os.path.join(self.state_dir, "url"))
        registration_token = os.environ.get("WMUX_REGISTRATION_TOKEN") or read_trimmed_file(
            os.path.join(self.state_dir, "registration-token")
        )
        heartbeat_config_path = os.environ.get("WMUX_HEARTBEAT_CONFIG") or os.path.join(
            self.state_dir, "heartbeat.json"
        )
        missing = []
        if not wmux_url:
            missing.append("url")
        if not registration_token:
            missing.append("registration-token")
        if not os.path.isfile(heartbeat_config_path):
            missing.append("heartbeat.json")
        if missing:
            raise HeartbeatNotConfigured(f"missing {', '.join(missing)}")
        if "\r" in registration_token or "\n" in registration_token:
            raise HeartbeatNotConfigured("registration token contains a newline")

        with open(heartbeat_config_path, "r", encoding="utf-8") as handle:
            registration = json.load(handle)
        if not isinstance(registration, dict) or not isinstance(registration.get("machine"), dict):
            raise HeartbeatNotConfigured("heartbeat.json must contain a machine object")

        machine = dict(registration["machine"])
        configured_machine = config_string(self.agent_config, "machine")
        registered_machine = machine.get("id")
        if configured_machine and registered_machine != configured_machine:
            raise HeartbeatNotConfigured("heartbeat machine id does not match windows-agent.json")
        agent_token = config_string(self.agent_config, "token") or os.environ.get("WMUX_AGENT_TOKEN", "")
        if not agent_token:
            raise HeartbeatNotConfigured("windows-agent.json is missing the agent token")

        # The running agent is authoritative for its callback port and token.
        # This prevents a stale heartbeat file from advertising credentials the
        # live listener does not accept.
        machine["sessionBackend"] = "agent"
        machine["agentPort"] = self.agent_port
        machine["agentToken"] = agent_token
        registration["machine"] = machine
        endpoint = f"{wmux_url.rstrip('/')}/api/registry/hosts"
        body = json.dumps(registration, separators=(",", ":")).encode("utf-8")
        return endpoint, registration_token, body

    def send_once(self) -> bool:
        if not self.enabled:
            return False
        attempted_at = utc_timestamp()
        with self.lock:
            self.status["lastAttemptAt"] = attempted_at
        try:
            endpoint, registration_token, body = self._registration_request()
        except (HeartbeatNotConfigured, OSError, ValueError, json.JSONDecodeError) as error:
            with self.lock:
                self.status["configured"] = False
                self.status["consecutiveFailures"] = 0
                self.status["lastError"] = str(error)
            return False

        try:
            request = Request(
                endpoint,
                data=body,
                headers={
                    "Authorization": f"Bearer {registration_token}",
                    "Content-Type": "application/json",
                },
                method="POST",
            )
            with urlopen(request, timeout=self.timeout_seconds) as response:
                status_code = int(getattr(response, "status", 200))
                response.read(4096)
            if status_code < 200 or status_code >= 300:
                raise RuntimeError(f"registration endpoint returned HTTP {status_code}")
        except HTTPError as error:
            return self._record_failure(f"registration endpoint returned HTTP {error.code}")
        except URLError as error:
            return self._record_failure(f"registration request failed: {error.reason}")
        except (OSError, RuntimeError, ValueError) as error:
            return self._record_failure(str(error))

        succeeded_at = utc_timestamp()
        with self.lock:
            recovering = bool(self.status["lastError"])
            self.status["configured"] = True
            self.status["lastSuccessAt"] = succeeded_at
            self.status["consecutiveFailures"] = 0
            self.status["lastError"] = None
        if recovering:
            print(f"{agent_program_name()}: registration heartbeat recovered", file=sys.stderr)
        return True

    def _record_failure(self, message: str) -> bool:
        failed_at = utc_timestamp()
        with self.lock:
            changed = self.status["lastError"] != message
            self.status["configured"] = True
            self.status["lastFailureAt"] = failed_at
            self.status["consecutiveFailures"] = int(self.status["consecutiveFailures"]) + 1
            self.status["lastError"] = message
        if changed:
            print(f"{agent_program_name()}: {message}", file=sys.stderr)
        return False


def stream_config_path(agent_config: dict[str, Any], agent_config_path: str) -> str:
    configured = config_string(agent_config, "streamConfig")
    if configured:
        return os.path.abspath(os.path.expandvars(os.path.expanduser(configured)))
    state_dir = config_string(agent_config, "stateDir")
    parent = state_dir or os.path.dirname(os.path.abspath(os.path.expanduser(agent_config_path)))
    return os.path.join(os.path.expandvars(os.path.expanduser(parent)), "stream-agent.json")


def stream_worker_command(
    agent_config: dict[str, Any],
    agent_config_path: str,
) -> tuple[list[str], str] | None:
    config_path = stream_config_path(agent_config, agent_config_path)
    if not os.path.isfile(config_path):
        return None
    explicit = config_string(agent_config, "streamAgentPath")
    helper_dir = config_string(agent_config, "helperDir")
    candidates = [
        explicit,
        os.path.join(
            os.path.dirname(config_path),
            "WmuxStreamAgent.app",
            "Contents",
            "MacOS",
            "WmuxStreamAgent",
        ),
        os.path.join(helper_dir, "wmux-stream-agent.cmd") if helper_dir else "",
        os.path.join(helper_dir, "wmux-stream-agent.py") if helper_dir else "",
        os.path.join(_PROTOCOL_SEARCH_ROOT, "wmux-stream-agent"),
        os.path.join(_PROTOCOL_SEARCH_ROOT, "wmux-stream-agent.py"),
        shutil.which("wmux-stream-agent") or "",
    ]
    worker = next(
        (
            os.path.abspath(os.path.expandvars(os.path.expanduser(candidate)))
            for candidate in candidates
            if candidate
            and os.path.isfile(os.path.expandvars(os.path.expanduser(candidate)))
        ),
        "",
    )
    if not worker:
        return None
    arguments = [worker, "--config", config_path]
    if worker.lower().endswith(".py"):
        arguments.insert(0, sys.executable)
    elif os.name == "nt" and worker.lower().endswith((".cmd", ".bat")):
        arguments = [os.environ.get("COMSPEC", "cmd.exe"), "/d", "/s", "/c", *arguments]
    return arguments, config_path


class StreamSupervisor:
    def __init__(self, agent_config: dict[str, Any], agent_config_path: str):
        self.agent_config = agent_config
        self.agent_config_path = agent_config_path
        self.owner = config_bool(agent_config, "streamOwner", True)
        self.enabled = config_bool(agent_config, "streamEnabled", True)
        self.stop_event = threading.Event()
        self.lock = threading.Lock()
        self.thread: threading.Thread | None = None
        self.process: subprocess.Popen[bytes] | None = None
        self.status: dict[str, Any] = {
            "owner": self.owner,
            "enabled": self.enabled,
            "configured": os.path.isfile(stream_config_path(agent_config, agent_config_path)),
            "running": False,
            "pid": None,
            "restartCount": 0,
            "lastStartedAt": None,
            "lastExitAt": None,
            "lastExitCode": None,
            "lastError": None,
        }

    def snapshot(self) -> dict[str, Any]:
        with self.lock:
            return dict(self.status)

    def start(self) -> None:
        if not self.owner or not self.enabled or self.thread:
            return
        self.thread = threading.Thread(
            target=self._run,
            name="wmux-stream-supervisor",
            daemon=True,
        )
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()
        with self.lock:
            process = self.process
        if process and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
        if self.thread and self.thread.is_alive():
            self.thread.join(timeout=4)

    def _run(self) -> None:
        failures = 0
        while not self.stop_event.is_set():
            resolved = stream_worker_command(self.agent_config, self.agent_config_path)
            if not resolved:
                with self.lock:
                    self.status["configured"] = os.path.isfile(
                        stream_config_path(self.agent_config, self.agent_config_path)
                    )
                    self.status["lastError"] = (
                        "stream config is missing"
                        if not self.status["configured"]
                        else "wmux-stream-agent executable was not found"
                    )
                self.stop_event.wait(DEFAULT_STREAM_RESTART_MAX_SECONDS)
                continue
            command, _config_path = resolved
            started_at = time.monotonic()
            try:
                process = subprocess.Popen(command)
                with self.lock:
                    self.process = process
                    self.status.update({
                        "configured": True,
                        "running": True,
                        "pid": process.pid,
                        "lastStartedAt": utc_timestamp(),
                        "lastError": None,
                    })
                while process.poll() is None and not self.stop_event.wait(0.25):
                    pass
                if self.stop_event.is_set() and process.poll() is None:
                    process.terminate()
                exit_code = process.wait()
                ran_seconds = time.monotonic() - started_at
                failures = 0 if ran_seconds >= 30 else failures + 1
                with self.lock:
                    self.process = None
                    self.status.update({
                        "running": False,
                        "pid": None,
                        "restartCount": self.status["restartCount"] + (
                            0 if self.stop_event.is_set() else 1
                        ),
                        "lastExitAt": utc_timestamp(),
                        "lastExitCode": exit_code,
                    })
            except OSError as error:
                failures += 1
                with self.lock:
                    self.process = None
                    self.status.update({
                        "running": False,
                        "pid": None,
                        "lastExitAt": utc_timestamp(),
                        "lastError": str(error),
                        "restartCount": self.status["restartCount"] + 1,
                    })
            if self.stop_event.is_set():
                return
            self.stop_event.wait(min(DEFAULT_STREAM_RESTART_MAX_SECONDS, 2 ** min(failures, 5)))


def retire_legacy_heartbeat_task(config: dict[str, Any]) -> None:
    if os.name != "nt":
        if sys.platform.startswith("linux"):
            try:
                subprocess.run(
                    [
                        "systemctl",
                        "--user",
                        "disable",
                        "--now",
                        "wmux-heartbeat.timer",
                        "wmux-heartbeat.service",
                    ],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=10,
                    check=False,
                )
            except (OSError, subprocess.SubprocessError):
                pass
        return
    task_name = os.environ.get("WMUX_HEARTBEAT_TASK") or "wmux-heartbeat"
    creation_flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
    for arguments in (("/End", "/TN", task_name), ("/Delete", "/F", "/TN", task_name)):
        try:
            subprocess.run(
                ["schtasks.exe", *arguments],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
                check=False,
                creationflags=creation_flags,
            )
        except (OSError, subprocess.SubprocessError):
            pass
    configured_helper_dir = os.path.expanduser(os.path.expandvars(config_string(config, "helperDir")))
    if configured_helper_dir:
        helper_dir = os.path.abspath(configured_helper_dir)
        for name in ("wmux-heartbeat-service.ps1", "wmux-heartbeat-service.cmd", "wmux-heartbeat-task.ps1"):
            try:
                os.remove(os.path.join(helper_dir, name))
            except OSError:
                pass


def pywinpty_available() -> bool:
    if os.name != "nt":
        return False
    try:
        import winpty  # type: ignore

        return hasattr(winpty, "PtyProcess")
    except Exception:
        return False


def conpty_available() -> bool:
    return pywinpty_available()


def configured_backend(config: dict[str, Any]) -> str:
    default_backend = BACKEND_CONPTY if os.name == "nt" else BACKEND_PTY
    value = config_string(config, "backend", default_backend).strip().lower()
    if os.name != "nt":
        if value in (BACKEND_STDIO, "legacy", "legacy-stdio"):
            return BACKEND_STDIO
        return BACKEND_PTY
    if value in (BACKEND_STDIO, "legacy", "legacy-stdio"):
        return BACKEND_STDIO
    if value == "auto":
        return BACKEND_CONPTY if conpty_available() else BACKEND_STDIO
    return BACKEND_CONPTY


def helper_bundle_version(config: dict[str, Any]) -> str:
    helper_dir = os.path.expandvars(config_string(config, "helperDir"))
    version_path = os.path.join(helper_dir, "bundle-version.json") if helper_dir else ""
    if not version_path or not os.path.isfile(version_path):
        return ""
    try:
        with open(version_path, "r", encoding="utf-8") as handle:
            value = json.load(handle)
        return str(value.get("bundleVersion") or "") if isinstance(value, dict) else ""
    except Exception:
        return ""


def agent_release_version(config: dict[str, Any]) -> str:
    configured = config_string(config, "releaseVersion")
    if configured:
        return configured
    if not RELEASE_VERSION.startswith("__"):
        return RELEASE_VERSION
    try:
        package_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "package.json")
        with open(package_path, "r", encoding="utf-8") as handle:
            version = str(json.load(handle).get("version") or "")
        if version:
            platform = "mac" if sys.platform == "darwin" else "linux"
            return f"v{version}-{platform}"
    except (OSError, ValueError, TypeError):
        pass
    return "v0.0.0-linux"


def _owned_directory(path: str, private: bool) -> None:
    status = os.lstat(path)
    if not os.path.isdir(path) or os.path.islink(path) or os.path.realpath(path) != os.path.abspath(path):
        raise ValueError("runtime_directory_unsafe")
    if hasattr(os, "getuid") and status.st_uid != os.getuid():
        raise ValueError("runtime_directory_unsafe")
    if private and status.st_mode & 0o077:
        raise ValueError("runtime_directory_unsafe")


def _private_child_directory(parent: str, name: str) -> str:
    _owned_directory(parent, True)
    child = os.path.join(parent, name)
    try:
        os.mkdir(child, 0o700)
    except FileExistsError:
        pass
    _owned_directory(child, True)
    os.chmod(child, 0o700)
    return child


def runtime_file_directory(session_id: str) -> str:
    if os.name == "nt":
        raise ValueError("runtime_files_unsupported")
    runtime_base = os.environ.get("XDG_RUNTIME_DIR", "")
    if runtime_base:
        if not os.path.isabs(runtime_base):
            raise ValueError("runtime_directory_unsafe")
        _owned_directory(runtime_base, True)
        wmux_root = _private_child_directory(runtime_base, "wmux")
    else:
        home = os.path.abspath(os.path.expanduser("~"))
        _owned_directory(home, False)
        wmux_home = os.path.join(home, ".wmux")
        try:
            os.mkdir(wmux_home, 0o700)
        except FileExistsError:
            pass
        _owned_directory(wmux_home, True)
        os.chmod(wmux_home, 0o700)
        wmux_root = _private_child_directory(wmux_home, "run")
    runtime_root = _private_child_directory(wmux_root, "session-files")
    session_name = hashlib.sha256(session_id.encode("utf-8")).hexdigest()[:32]
    return _private_child_directory(runtime_root, session_name)


def _private_runtime_file(path: str) -> None:
    status = os.lstat(path)
    if not os.path.isfile(path) or os.path.islink(path) or os.path.realpath(path) != os.path.abspath(path):
        raise ValueError("runtime_file_unsafe")
    if hasattr(os, "getuid") and status.st_uid != os.getuid():
        raise ValueError("runtime_file_unsafe")
    if status.st_mode & 0o777 != 0o600:
        raise ValueError("runtime_file_unsafe")


def _write_private_runtime_file(path: str, data: bytes) -> None:
    if os.path.lexists(path):
        _private_runtime_file(path)
    temporary = os.path.join(
        os.path.dirname(path),
        f".{os.path.basename(path)}.{os.getpid()}.{threading.get_ident()}.tmp",
    )
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        _private_runtime_file(path)
        directory = os.open(os.path.dirname(path), os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def stage_runtime_files(payload: dict[str, Any], session_id: str) -> None:
    payload_env = payload.get("env")
    if not isinstance(payload_env, dict):
        payload_env = {}
        payload["env"] = payload_env
    for key in (
        "WMUX_AGENT_INPUT_REGISTRATION_CAPABILITY",
        "WMUX_AGENT_INPUT_CAPABILITY_PATH",
        "WMUX_AGENT_INPUT_CREDENTIAL_PATH",
    ):
        payload_env.pop(key, None)
    entries = payload.get("runtimeFiles")
    if entries is None or entries == []:
        return
    if os.name == "nt" or not isinstance(entries, list) or len(entries) != 1:
        raise ValueError("invalid_runtime_files")
    entry = entries[0]
    if not isinstance(entry, dict) or entry.get("purpose") != "agent-input-capability":
        raise ValueError("invalid_runtime_file")
    data = base64.b64decode(str(entry.get("dataBase64") or ""), validate=True)
    expected = str(entry.get("sha256") or "").lower()
    if not data or len(data) > 4096 or not expected or not hmac.compare_digest(hashlib.sha256(data).hexdigest(), expected):
        raise ValueError("invalid_runtime_file")
    directory = runtime_file_directory(session_id)
    capability_path = os.path.join(directory, "agent-input.cap")
    credential_path = os.path.join(directory, "agent-input.json")
    if os.path.lexists(credential_path):
        _private_runtime_file(credential_path)
    _write_private_runtime_file(capability_path, data)
    payload_env["WMUX_AGENT_INPUT_CAPABILITY_PATH"] = capability_path
    payload_env["WMUX_AGENT_INPUT_CREDENTIAL_PATH"] = credential_path


def delete_session_runtime_files(session_id: str) -> None:
    if os.name == "nt":
        return
    try:
        directory = runtime_file_directory(session_id)
        _owned_directory(directory, True)
        shutil.rmtree(directory)
    except (FileNotFoundError, OSError, ValueError):
        pass


def refresh_callback_state(payload: dict[str, Any]) -> None:
    payload_env = payload.get("env")
    if not isinstance(payload_env, dict):
        return
    values = {
        "url": payload_env.get("WMUX_URL"),
        "token": payload_env.get("WMUX_TOKEN"),
    }
    if not any(isinstance(value, str) and value.strip() for value in values.values()):
        return
    state_dir = os.path.expanduser("~/.wmux")
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    try:
        os.chmod(state_dir, 0o700)
    except OSError:
        pass
    for name, raw_value in values.items():
        if not isinstance(raw_value, str) or not raw_value.strip():
            continue
        path = os.path.join(state_dir, name)
        temporary = f"{path}.tmp-{os.getpid()}-{threading.get_ident()}"
        try:
            with open(temporary, "w", encoding="utf-8", newline="\n") as handle:
                handle.write(raw_value.strip())
                handle.write("\n")
            os.chmod(temporary, 0o600)
            os.replace(temporary, path)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def stage_helper_bundle(config: dict[str, Any], payload: dict[str, Any]) -> None:
    # A create request also serves as an attach request for an existing durable
    # ConPTY session. Refresh callback state even when no helper files changed.
    refresh_callback_state(payload)
    bundle = payload.get("helperBundle")
    if not isinstance(bundle, dict) or not isinstance(bundle.get("files"), list):
        return
    helper_dir = os.path.expandvars(config_string(config, "helperDir"))
    if not helper_dir:
        return
    os.makedirs(helper_dir, exist_ok=True)
    staging = os.path.join(helper_dir, f".staging-agent-{os.getpid()}-{threading.get_ident()}")
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(staging)
    try:
        staged_names: list[str] = []
        for entry in bundle["files"]:
            if not isinstance(entry, dict):
                raise ValueError("helper manifest entry must be an object")
            name = str(entry.get("name") or "")
            if not name or os.path.basename(name) != name:
                raise ValueError("helper manifest contains an invalid file name")
            data = base64.b64decode(str(entry.get("dataBase64") or ""), validate=True)
            expected = str(entry.get("sha256") or "").lower()
            if not expected or not hmac.compare_digest(hashlib.sha256(data).hexdigest(), expected):
                raise ValueError(f"helper hash verification failed for {name}")
            with open(os.path.join(staging, name), "wb") as handle:
                handle.write(data)
            staged_names.append(name)
        for name in staged_names:
            os.replace(os.path.join(staging, name), os.path.join(helper_dir, name))
        version = str(bundle.get("bundleVersion") or "")
        if version:
            version_path = os.path.join(helper_dir, "bundle-version.json")
            temporary_version = version_path + ".tmp"
            with open(temporary_version, "w", encoding="utf-8") as handle:
                json.dump({"bundleVersion": version}, handle)
                handle.write("\n")
            os.replace(temporary_version, version_path)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def is_private_bind_host(host: str) -> bool:
    if host in ("localhost", "::1") or host.startswith("127."):
        return True
    match = re.match(r"^(\d+)\.(\d+)\.(\d+)\.(\d+)$", host)
    if not match:
        return False
    first, second = int(match.group(1)), int(match.group(2))
    if first == 10 or first == 192 and second == 168:
        return True
    if first == 172 and 16 <= second <= 31:
        return True
    return first == 100 and 64 <= second <= 127


# Byte-identical copy of scripts/windows/wmux-cwd-prompt.ps1. The agent runs
# standalone on the Windows host, so it cannot read the wmux checkout; wmux's
# test/osc7.test.ts asserts this constant matches the canonical file.
CWD_PROMPT_PS1 = r"""function global:__wmuxFileUriPath([string]$PathValue) {
  $Normalized = $PathValue -replace '\\', '/'
  if ($Normalized -match '^[A-Za-z]:') {
    $Normalized = '/' + $Normalized
  }
  $Segments = $Normalized.Split([char]'/', [System.StringSplitOptions]::None)
  return (($Segments | ForEach-Object { [System.Uri]::EscapeDataString($_) }) -join '/')
}

function global:__wmuxEmitCwd {
  try {
    if ($PWD.Provider.Name -ne 'FileSystem') { return }
    $HostName = if ($env:COMPUTERNAME) { $env:COMPUTERNAME } else { 'windows' }
    $PathPart = __wmuxFileUriPath $PWD.ProviderPath
    [Console]::Write("$([char]27)]7;file://$HostName$PathPart$([char]7)")
  } catch {}
}

function global:__wmuxClearPromptTail {
  try {
    # ConPTY console coordinates can lag terminal output, so never reposition here.
    [Console]::Write("$([char]27)[0K")
  } catch {}
}

function global:__wmuxInstallPrompt([bool]$PreserveExisting) {
  if (-not (Test-Path variable:global:__wmuxPromptInstalled)) {
    $ExistingPrompt = Get-Command prompt -CommandType Function -ErrorAction SilentlyContinue
    $global:__wmuxOriginalPrompt = if ($ExistingPrompt) { $ExistingPrompt.ScriptBlock } else { $null }
  }
  $global:__wmuxPreserveOriginalPrompt = $PreserveExisting
  function global:prompt {
    __wmuxClearPromptTail
    __wmuxEmitCwd
    if ($global:__wmuxPreserveOriginalPrompt -and $global:__wmuxOriginalPrompt) {
      try {
        & $global:__wmuxOriginalPrompt
        return
      } catch {}
    }
    "PS $($executionContext.SessionState.Path.CurrentLocation)> "
  }
  $global:__wmuxPromptInstalled = $true
}

try {
  # Native tools write UTF-8; without this conhost decodes them with the OEM
  # code page and the browser sees mojibake. Applies to stdio sessions too.
  $WmuxUtf8 = [System.Text.UTF8Encoding]::new($false)
  [Console]::OutputEncoding = $WmuxUtf8
  [Console]::InputEncoding = $WmuxUtf8
  $global:OutputEncoding = $WmuxUtf8
} catch {}

try {
  Set-PSReadLineOption -PredictionSource None -ErrorAction SilentlyContinue
} catch {}
"""

WINDOWS_CONSOLE_THEME_PS1 = r"""function global:__wmuxColorRef([string]$Value) {
  if ($Value -notmatch '^#([0-9a-fA-F]{6})$') { throw 'invalid wmux console color' }
  $Rgb = [Convert]::ToUInt32($Matches[1], 16)
  return (($Rgb -band 0xff0000) -shr 16) -bor ($Rgb -band 0x00ff00) -bor (($Rgb -band 0x0000ff) -shl 16)
}

function global:__wmuxApplyConsoleTheme {
  try {
    $Ansi = @($env:WMUX_TERMINAL_ANSI_PALETTE -split ',')
    if ($Ansi.Count -ne 16 -or -not $env:WMUX_TERMINAL_BACKGROUND -or -not $env:WMUX_TERMINAL_FOREGROUND) { return }
    if (-not ('WmuxConsoleTheme.Native' -as [type])) {
      Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;

namespace WmuxConsoleTheme {
  [StructLayout(LayoutKind.Sequential)]
  public struct Coord { public short X; public short Y; }

  [StructLayout(LayoutKind.Sequential)]
  public struct SmallRect { public short Left; public short Top; public short Right; public short Bottom; }

  [StructLayout(LayoutKind.Sequential)]
  public struct ScreenBufferInfoEx {
    public uint Size;
    public Coord BufferSize;
    public Coord CursorPosition;
    public ushort Attributes;
    public SmallRect Window;
    public Coord MaximumWindowSize;
    public ushort PopupAttributes;
    [MarshalAs(UnmanagedType.Bool)] public bool FullscreenSupported;
    [MarshalAs(UnmanagedType.ByValArray, SizeConst = 16)] public uint[] ColorTable;
  }

  public static class Native {
    [DllImport("kernel32.dll", SetLastError = true)]
    static extern IntPtr GetStdHandle(int handle);
    [DllImport("kernel32.dll", SetLastError = true)]
    static extern bool GetConsoleScreenBufferInfoEx(IntPtr output, ref ScreenBufferInfoEx info);
    [DllImport("kernel32.dll", SetLastError = true)]
    static extern bool SetConsoleScreenBufferInfoEx(IntPtr output, ref ScreenBufferInfoEx info);
    [DllImport("kernel32.dll", SetLastError = true)]
    static extern bool SetConsoleTextAttribute(IntPtr output, ushort attributes);
    [DllImport("kernel32.dll", SetLastError = true)]
    static extern bool SetConsoleWindowInfo(IntPtr output, bool absolute, ref SmallRect window);

    public static bool Apply(uint[] colors) {
      if (colors == null || colors.Length != 16) return false;
      IntPtr output = GetStdHandle(-11);
      var info = new ScreenBufferInfoEx {
        Size = (uint)Marshal.SizeOf<ScreenBufferInfoEx>(),
        ColorTable = new uint[16],
      };
      if (!GetConsoleScreenBufferInfoEx(output, ref info)) return false;
      info.ColorTable = colors;
      info.Attributes = (ushort)((info.Attributes & 0xff00) | 0x07);
      info.PopupAttributes = (ushort)((info.PopupAttributes & 0xff00) | 0x07);
      var window = info.Window;
      if (!SetConsoleScreenBufferInfoEx(output, ref info)) return false;
      // SetConsoleScreenBufferInfoEx reads the window rectangle one cell
      // smaller than GetConsoleScreenBufferInfoEx reports it, so writing the
      // info back shrinks the console. Under ConPTY that leaves the console a
      // row shorter than the terminal it renders into, and every absolute
      // cursor move lands one row off. Restore the exact pane geometry.
      var applied = new ScreenBufferInfoEx {
        Size = (uint)Marshal.SizeOf<ScreenBufferInfoEx>(),
        ColorTable = new uint[16],
      };
      if (GetConsoleScreenBufferInfoEx(output, ref applied)
        && (applied.Window.Right - applied.Window.Left != window.Right - window.Left
          || applied.Window.Bottom - applied.Window.Top != window.Bottom - window.Top)) {
        SetConsoleWindowInfo(output, true, ref window);
      }
      return SetConsoleTextAttribute(output, info.Attributes);
    }
  }
}
'@ -ErrorAction Stop
    }

    # ConsoleColor uses the Windows BGR bit order, while terminal palettes use ANSI order.
    $AnsiForWindows = @(0, 4, 2, 6, 1, 5, 3, 7, 8, 12, 10, 14, 9, 13, 11, 15)
    $Colors = [uint32[]]::new(16)
    for ($Index = 0; $Index -lt 16; $Index++) {
      $Colors[$Index] = __wmuxColorRef $Ansi[$AnsiForWindows[$Index]]
    }
    # ConPTY flattens the inherited default attributes into explicit RGB. Give
    # those two semantic slots the terminal's actual default colors.
    $Colors[0] = __wmuxColorRef $env:WMUX_TERMINAL_BACKGROUND
    $Colors[7] = __wmuxColorRef $env:WMUX_TERMINAL_FOREGROUND
    if ([WmuxConsoleTheme.Native]::Apply($Colors)) {
      [Console]::BackgroundColor = [ConsoleColor]::Black
      [Console]::ForegroundColor = [ConsoleColor]::Gray
      [Console]::Clear()
    }
  } catch {}
}

__wmuxApplyConsoleTheme
"""


def powershell_bootstrap(cwd: str, preserve_prompt: bool) -> str:
    escaped_cwd = cwd.replace("'", "''")
    preserve_prompt_literal = "$true" if preserve_prompt else "$false"
    cwd_bootstrap = (
        f"\nSet-Location -LiteralPath '{escaped_cwd}' -ErrorAction SilentlyContinue"
        if cwd
        else ""
    )
    return (
        "\n$WmuxOriginalErrorActionPreference = $ErrorActionPreference\n$ErrorActionPreference = 'Continue'\n"
        + WINDOWS_CONSOLE_THEME_PS1
        + CWD_PROMPT_PS1
        + f"""
{cwd_bootstrap}
__wmuxInstallPrompt {preserve_prompt_literal}
__wmuxEmitCwd
$ErrorActionPreference = $WmuxOriginalErrorActionPreference
"""
    )


def powershell_command(
    shell: str,
    cwd: str,
    load_profile: bool = False,
) -> list[str]:
    executable = shell or "pwsh"
    command = [
        executable,
        "-NoLogo",
    ]
    if not load_profile:
        command.append("-NoProfile")
    command.extend([
        "-ExecutionPolicy",
        "Bypass",
        "-NoExit",
        "-Command",
        powershell_bootstrap(cwd, load_profile),
    ])
    return command


def session_environment(config: dict[str, Any], payload: dict[str, Any]) -> dict[str, str]:
    env = os.environ.copy()
    env.setdefault("TERM", "xterm-256color")
    env.setdefault("COLORTERM", "truecolor")
    helper_dir = os.path.expandvars(config_string(config, "helperDir"))
    if helper_dir:
        env["PATH"] = helper_dir + os.pathsep + env.get("PATH", "")
        env["WMUX_HELPER_DIR"] = helper_dir
    payload_env = payload.get("env")
    if isinstance(payload_env, dict):
        for key, value in payload_env.items():
            if isinstance(key, str) and isinstance(value, str):
                env[key] = value
    return env


def session_command(config: dict[str, Any], payload: dict[str, Any], cwd: str) -> list[str] | str:
    default_shell = "pwsh" if os.name == "nt" else os.environ.get("SHELL") or "/bin/sh"
    shell = str(payload.get("shell") or config_string(config, "shell", default_shell))
    lower_shell = os.path.basename(shell).lower()
    if lower_shell in ("pwsh", "pwsh.exe", "powershell", "powershell.exe"):
        requested_cwd = str(payload.get("cwd") or config_string(config, "cwd") or "")
        return powershell_command(
            shell,
            requested_cwd,
            payload.get("loadPowerShellProfile") is True,
        )
    return shell if os.name == "nt" else [shell, "-l"]


def stdio_input_bytes(data: bytes) -> bytes:
    """Map terminal keystrokes onto a line-oriented pipe.

    Enter arrives as CR and pasted Windows text as CRLF; both must become one
    LF so a pasted block does not run every line followed by an empty command.
    """
    return data.replace(b"\r\n", b"\n").replace(b"\r", b"\n")


class StdioBackend:
    name = BACKEND_STDIO

    def __init__(self, config: dict[str, Any], payload: dict[str, Any], cwd: str):
        command = session_command(config, payload, cwd)
        self.last_output_byte_was_cr = False
        self.process = subprocess.Popen(
            command,
            cwd=cwd if os.path.isdir(cwd) else None,
            env=session_environment(config, payload),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            creationflags=getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0),
        )
        try:
            self.process_tree = WindowsProcessTree(self.pid) if os.name == "nt" else None
        except Exception:
            self.process.terminate()
            raise

    @property
    def pid(self) -> int:
        return int(self.process.pid or 0)

    def write(self, data: bytes) -> None:
        if not self.process.stdin:
            return
        payload = stdio_input_bytes(data)
        if not payload:
            return
        self.process.stdin.write(payload)
        self.process.stdin.flush()

    def write_terminal_response(self, _data: bytes) -> None:
        # A pipe-backed shell reads stdin as command text, so a DA/DSR reply
        # would execute as a garbled command line instead of answering a query.
        return

    def resize(self, _cols: int, _rows: int) -> None:
        return

    def terminate(self) -> None:
        if self.process_tree:
            try:
                self.process_tree.terminate()
            except Exception:
                pass
        try:
            if os.name == "nt":
                self.process.send_signal(signal.CTRL_BREAK_EVENT)
                time.sleep(0.2)
            self.process.terminate()
        except Exception:
            pass

    def read_output(self, append: Any) -> int | None:
        try:
            while True:
                chunk = os.read(self.process.stdout.fileno(), 4096) if self.process.stdout else b""
                if not chunk:
                    break
                output, self.last_output_byte_was_cr = terminalize_stdio_output(
                    chunk,
                    self.last_output_byte_was_cr,
                )
                append(output)
            return self.process.poll()
        finally:
            if self.process_tree:
                try:
                    self.process_tree.terminate()
                except Exception:
                    pass


class PosixPtyBackend:
    name = BACKEND_PTY

    def __init__(self, config: dict[str, Any], payload: dict[str, Any], cwd: str, cols: int, rows: int):
        if os.name == "nt":
            raise RuntimeError("the POSIX PTY backend is unavailable on Windows")
        command = session_command(config, payload, cwd)
        if not isinstance(command, list) or not command:
            raise RuntimeError("the POSIX PTY backend requires an executable command")
        self.lock = threading.Lock()
        self.closed = False
        self.master_fd, slave_fd = os.openpty()
        self._set_size(slave_fd, cols, rows)

        def prepare_child() -> None:
            os.setsid()
            fcntl.ioctl(slave_fd, termios.TIOCSCTTY, 0)

        try:
            self.process = subprocess.Popen(
                command,
                cwd=cwd if os.path.isdir(cwd) else None,
                env=session_environment(config, payload),
                stdin=slave_fd,
                stdout=slave_fd,
                stderr=slave_fd,
                close_fds=True,
                preexec_fn=prepare_child,
            )
        except Exception:
            os.close(self.master_fd)
            raise
        finally:
            os.close(slave_fd)

    @property
    def pid(self) -> int:
        return int(self.process.pid or 0)

    def write(self, data: bytes) -> None:
        if self.closed or not data:
            return
        with self.lock:
            if self.closed:
                return
            os.write(self.master_fd, data)

    def write_terminal_response(self, data: bytes) -> None:
        self.write(data)

    def resize(self, cols: int, rows: int) -> None:
        if self.closed:
            return
        with self.lock:
            if self.closed:
                return
            self._set_size(self.master_fd, cols, rows)

    def terminate(self) -> None:
        with self.lock:
            if self.closed:
                return
        try:
            os.killpg(self.pid, signal.SIGHUP)
        except ProcessLookupError:
            return
        try:
            self.process.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(self.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def read_output(self, append: Any) -> int | None:
        try:
            while True:
                try:
                    chunk = os.read(self.master_fd, 4096)
                except OSError as error:
                    if error.errno == errno.EIO:
                        break
                    raise
                if not chunk:
                    break
                append(chunk)
            return self.process.wait()
        finally:
            with self.lock:
                if not self.closed:
                    self.closed = True
                    os.close(self.master_fd)

    @staticmethod
    def _set_size(descriptor: int, cols: int, rows: int) -> None:
        size = struct.pack("HHHH", max(1, int(rows)), max(2, int(cols)), 0, 0)
        fcntl.ioctl(descriptor, termios.TIOCSWINSZ, size)


def terminalize_stdio_output(data: bytes, previous_ended_with_cr: bool = False) -> tuple[bytes, bool]:
    """Make pipe output obey terminal newline semantics.

    A PTY/ConPTY normally maps line feeds into a cursor-return plus line-feed.
    Plain stdout pipes from PowerShell often emit bare LF, which leaves a web
    terminal cursor at the previous column and makes the next prompt drift
    right. Preserve existing CRLF and only insert CR before bare LF.
    """
    output = bytearray()
    previous_was_cr = previous_ended_with_cr
    for byte in data:
        if byte == 0x0A and not previous_was_cr:
            output.append(0x0D)
        output.append(byte)
        previous_was_cr = byte == 0x0D
    return bytes(output), previous_was_cr


COMMON_LVB_LEADING_BYTE = 0x0100
COMMON_LVB_TRAILING_BYTE = 0x0200
CONSOLE_SCREEN_READ_TIMEOUT_SECONDS = 5
# A screen read is exact only while the console is quiet: wait briefly for a
# pause in output, and retry when output raced the read.
SCREEN_CAPTURE_ATTEMPTS = 8
SCREEN_CAPTURE_QUIET_SECONDS = 0.05
SCREEN_CAPTURE_QUIET_LIMIT_SECONDS = 0.75
SCREEN_CAPTURE_SETTLE_SECONDS = 0.02
SCREEN_EVENT_LIMIT = 8
# Replay applies every recorded resize in order; bound a long output-free drag.
RESIZE_EVENT_LIMIT = 4096
# ReadConsoleOutputW copies through a bounded server buffer; keep each read
# comfortably below its 64 KiB limit.
CONSOLE_SCREEN_READ_CELLS = 12000


def read_console_screen(pid: int) -> dict[str, Any]:
    """Read ConPTY's own screen buffer for the console that owns `pid`.

    This runs in a detached helper process, never in the agent: attaching makes
    the caller a client of the pane's console, and the agent must stay free of
    every pane console. The helper ignores console control events while it is
    attached so a Ctrl+C typed into the pane cannot terminate it mid-read.
    """
    if os.name != "nt":
        raise RuntimeError("console screen reads require Windows")
    from ctypes import wintypes

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)

    class Coord(ctypes.Structure):
        _fields_ = [("X", wintypes.SHORT), ("Y", wintypes.SHORT)]

    class SmallRect(ctypes.Structure):
        _fields_ = [
            ("Left", wintypes.SHORT),
            ("Top", wintypes.SHORT),
            ("Right", wintypes.SHORT),
            ("Bottom", wintypes.SHORT),
        ]

    class ScreenBufferInfoEx(ctypes.Structure):
        _fields_ = [
            ("cbSize", wintypes.ULONG),
            ("dwSize", Coord),
            ("dwCursorPosition", Coord),
            ("wAttributes", wintypes.WORD),
            ("srWindow", SmallRect),
            ("dwMaximumWindowSize", Coord),
            ("wPopupAttributes", wintypes.WORD),
            ("bFullscreenSupported", wintypes.BOOL),
            ("ColorTable", wintypes.DWORD * 16),
        ]

    class CharInfo(ctypes.Structure):
        _fields_ = [("Char", wintypes.WCHAR), ("Attributes", wintypes.WORD)]

    class CursorInfo(ctypes.Structure):
        _fields_ = [("dwSize", wintypes.DWORD), ("bVisible", wintypes.BOOL)]

    kernel32.CreateFileW.restype = wintypes.HANDLE
    kernel32.CreateFileW.argtypes = [
        wintypes.LPCWSTR,
        wintypes.DWORD,
        wintypes.DWORD,
        wintypes.LPVOID,
        wintypes.DWORD,
        wintypes.DWORD,
        wintypes.HANDLE,
    ]
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
    kernel32.GetConsoleScreenBufferInfoEx.argtypes = [wintypes.HANDLE, ctypes.POINTER(ScreenBufferInfoEx)]
    kernel32.GetConsoleCursorInfo.argtypes = [wintypes.HANDLE, ctypes.POINTER(CursorInfo)]
    kernel32.ReadConsoleOutputW.argtypes = [
        wintypes.HANDLE,
        ctypes.POINTER(CharInfo),
        Coord,
        Coord,
        ctypes.POINTER(SmallRect),
    ]

    def failure(operation: str) -> OSError:
        code = ctypes.get_last_error()
        return OSError(code, f"{operation} failed with Windows error {code}")

    kernel32.FreeConsole()
    if not kernel32.AttachConsole(wintypes.DWORD(pid)):
        raise failure("AttachConsole")
    try:
        kernel32.SetConsoleCtrlHandler(None, True)
        # Inherited standard handles are stale after attaching; open the
        # attached console's active output buffer explicitly.
        handle = kernel32.CreateFileW("CONOUT$", 0xC0000000, 0x3, None, 3, 0, None)
        if not handle or handle == wintypes.HANDLE(-1).value:
            raise failure("CreateFileW(CONOUT$)")
        try:
            info = ScreenBufferInfoEx()
            info.cbSize = ctypes.sizeof(ScreenBufferInfoEx)
            if not kernel32.GetConsoleScreenBufferInfoEx(handle, ctypes.byref(info)):
                raise failure("GetConsoleScreenBufferInfoEx")
            cursor_info = CursorInfo()
            cursor_visible = True
            if kernel32.GetConsoleCursorInfo(handle, ctypes.byref(cursor_info)):
                cursor_visible = bool(cursor_info.bVisible)
            window = info.srWindow
            cols = window.Right - window.Left + 1
            rows = window.Bottom - window.Top + 1
            if cols <= 0 or rows <= 0:
                raise RuntimeError("console window has no visible cells")
            chunk_rows = max(1, CONSOLE_SCREEN_READ_CELLS // cols)
            lines: list[dict[str, Any]] = []
            for first_row in range(window.Top, window.Bottom + 1, chunk_rows):
                count = min(chunk_rows, window.Bottom + 1 - first_row)
                cells = (CharInfo * (cols * count))()
                region = SmallRect(window.Left, first_row, window.Right, first_row + count - 1)
                if not kernel32.ReadConsoleOutputW(handle, cells, Coord(cols, count), Coord(0, 0), ctypes.byref(region)):
                    raise failure("ReadConsoleOutputW")
                for row in range(count):
                    lines.append(console_screen_line(cells[row * cols:(row + 1) * cols]))
            return {
                "cols": cols,
                "rows": rows,
                "cursorX": info.dwCursorPosition.X - window.Left,
                "cursorY": info.dwCursorPosition.Y - window.Top,
                "cursorVisible": cursor_visible,
                "lines": lines,
            }
        finally:
            kernel32.CloseHandle(handle)
    finally:
        kernel32.FreeConsole()


def console_screen_line(cells: Any) -> dict[str, Any]:
    """Encode one console row as text, wide-glyph starts, and attribute runs."""
    text: list[str] = []
    wide: list[int] = []
    attrs: list[list[int]] = []
    count = len(cells)
    for column, cell in enumerate(cells):
        attribute = int(cell.Attributes)
        visible_attribute = attribute & ~(COMMON_LVB_LEADING_BYTE | COMMON_LVB_TRAILING_BYTE)
        if attrs and attrs[-1][0] == visible_attribute:
            attrs[-1][1] += 1
        else:
            attrs.append([visible_attribute, 1])
        character = cell.Char if cell.Char not in ("", "\x00") else " "
        if wide and wide[-1] == column - 1:
            # The second half of a wide glyph already emitted with its start.
            continue
        if (
            attribute & COMMON_LVB_LEADING_BYTE
            and column + 1 < count
            and int(cells[column + 1].Attributes) & COMMON_LVB_TRAILING_BYTE
        ):
            wide.append(column)
        elif attribute & COMMON_LVB_TRAILING_BYTE:
            # An orphaned half still occupies one blank cell.
            character = " "
        text.append(character)
    line: dict[str, Any] = {"text": "".join(text)}
    if wide:
        line["wide"] = wide
    if attrs:
        line["attrs"] = attrs
    return line


def console_screen_helper_command(pid: int) -> list[str]:
    return [sys.executable, os.path.abspath(__file__), "--read-console-screen", str(int(pid))]


def valid_console_screen(value: Any) -> bool:
    if not isinstance(value, dict):
        return False
    for key in ("cols", "rows", "cursorX", "cursorY"):
        if not isinstance(value.get(key), int) or isinstance(value.get(key), bool):
            return False
    lines = value.get("lines")
    return (
        value["cols"] > 0
        and value["rows"] > 0
        and isinstance(value.get("cursorVisible"), bool)
        and isinstance(lines, list)
        and len(lines) == value["rows"]
        and all(isinstance(line, dict) and isinstance(line.get("text"), str) for line in lines)
    )


class ConptyBackend:
    name = BACKEND_CONPTY
    supports_screen = os.name == "nt"

    def __init__(self, config: dict[str, Any], payload: dict[str, Any], cwd: str, cols: int, rows: int):
        if not conpty_available():
            raise RuntimeError("pywinpty is required for the wmux ConPTY backend; run wmux-windows-setup install-deps")
        from winpty import Backend, PtyProcess  # type: ignore

        command = session_command(config, payload, cwd)
        environment = session_environment(config, payload)
        self.process = PtyProcess.spawn(
            command,
            cwd=cwd if os.path.isdir(cwd) else None,
            env=environment,
            dimensions=(max(1, int(rows)), max(2, int(cols))),
            backend=Backend.ConPTY,
        )
        try:
            self.process_tree = WindowsProcessTree(self.pid)
        except Exception:
            try:
                self.process.terminate(force=True)
                self.process.close(force=True)
            except Exception:
                pass
            raise
        self.lock = threading.Lock()
        self.closed = False
        self.query_responder = TerminalQueryResponder(local_terminal_query_responses(environment))
        self.locally_answered: set[bytes] = set()

    @property
    def pid(self) -> int:
        return int(self.process.pid or 0)

    def write(self, data: bytes) -> None:
        if self.closed or not data:
            return
        with self.lock:
            if self.closed:
                return
            self.process.write(data.decode("utf-8", errors="replace"))

    def write_terminal_response(self, data: bytes) -> None:
        if self.closed or not data:
            return
        with self.lock:
            if self.closed:
                return
            records = split_terminal_response_records(data)
            if records is None:
                records = [data]
            forwarded = b"".join(
                record
                for record in records
                if record not in self.locally_answered
                and not self.query_responder.owns_response(record)
            )
            if forwarded:
                self.process.write(forwarded.decode("utf-8", errors="replace"))

    def resize(self, cols: int, rows: int) -> None:
        if self.closed:
            return
        cols = max(2, int(cols))
        rows = max(1, int(rows))
        with self.lock:
            if self.closed:
                return
            self.process.setwinsize(rows, cols)

    def terminate(self) -> None:
        with self.lock:
            if self.closed:
                return
            try:
                self.process_tree.terminate()
            except Exception:
                pass
            try:
                self.process.terminate(force=True)
            except Exception:
                pass
            try:
                self.process.close(force=True)
            except Exception:
                pass
            self.closed = True

    def read_output(self, append: Any) -> int | None:
        try:
            while True:
                chunk = self.process.fileobj.recv(4096)
                if not chunk:
                    break
                chunk = chunk.replace(b"0011Ignore", b"")
                if chunk:
                    self._answer_terminal_queries(chunk)
                    append(chunk)
        except OSError:
            pass
        finally:
            exit_code = self._exit_code()
            self._close()
        return exit_code

    def read_screen(self) -> dict[str, Any]:
        pid = self.pid
        if self.closed or pid <= 0:
            raise RuntimeError("pseudoconsole is closed")
        result = subprocess.run(
            console_screen_helper_command(pid),
            capture_output=True,
            timeout=CONSOLE_SCREEN_READ_TIMEOUT_SECONDS,
            creationflags=0x00000008,  # DETACHED_PROCESS: no console of its own
        )
        if result.returncode != 0:
            detail = result.stderr.decode("utf-8", errors="replace").strip()
            raise RuntimeError(f"console screen read failed: {detail or result.returncode}")
        screen = json.loads(result.stdout.decode("utf-8"))
        if not valid_console_screen(screen):
            raise RuntimeError("console screen read returned an invalid screen")
        return screen

    def _answer_terminal_queries(self, data: bytes) -> None:
        replies = self.query_responder.feed(data)
        if not replies:
            return
        with self.lock:
            if self.closed:
                return
            for reply in replies:
                self.locally_answered.add(reply)
                self.process.write(reply.decode("ascii"))

    def _exit_code(self) -> int | None:
        try:
            if self.process.isalive():
                return None
            value = self.process.exitstatus
            return int(value) if value is not None else None
        except Exception:
            return None

    def _close(self) -> None:
        with self.lock:
            if self.closed:
                return
            try:
                self.process_tree.terminate()
            except Exception:
                pass
            try:
                self.process.close(force=True)
            except Exception:
                pass
            self.closed = True


class Session:
    def __init__(
        self,
        session_id: str,
        config: dict[str, Any],
        payload: dict[str, Any],
        on_exit: Callable[[], None] | None = None,
    ):
        self.id = session_id
        self.config = config
        self.cwd = str(payload.get("cwd") or config_string(config, "cwd") or os.path.expanduser("~"))
        self.max_replay = max(65536, config_int(config, "maxReplayBytes", DEFAULT_REPLAY_BYTES))
        self.buffer = bytearray()
        self.base = 0
        self.condition = threading.Condition()
        self.cols = max(2, int(payload.get("cols") or 80))
        self.rows = max(1, int(payload.get("rows") or 24))
        # Resize and screen events share one sequence: several resizes can land
        # at one byte position, and ConPTY's reflow depends on every step.
        self.event_seq = 0
        self.resize_events: list[dict[str, int]] = [{"seq": 0, "cursor": 0, "cols": self.cols, "rows": self.rows}]
        self.screen_events: list[dict[str, Any]] = []
        self.last_output_at = time.monotonic()
        self.screen_capture_lock = threading.Lock()
        self.screen_capture_pending: str | None = None
        self.screen_capture_running = False
        self.cwd_reporter = CwdReporter()
        self.exited = False
        self.exit_code: int | None = None
        self.on_exit = on_exit
        self.backend = self._create_backend(payload)
        self.reader = threading.Thread(target=self._read_output, name=f"wmux-agent-reader-{session_id}", daemon=True)
        self.reader.start()

    @property
    def cursor(self) -> int:
        return self.base + len(self.buffer)

    @property
    def pid(self) -> int:
        return self.backend.pid

    def snapshot(self) -> dict[str, Any]:
        return {
            "id": self.id,
            "pid": self.pid,
            "backend": self.backend.name,
            "status": "exited" if self.exited else "running",
            "exitCode": self.exit_code,
            "cwd": self.cwd,
            "base": self.base,
            "cursor": self.cursor,
            "cols": self.cols,
            "rows": self.rows,
        }

    def write(self, data: bytes, terminal_response: bool = False) -> None:
        if self.exited:
            return
        if terminal_response:
            self.backend.write_terminal_response(data)
        else:
            self.backend.write(data)

    def resize(self, cols: int, rows: int) -> None:
        if self.exited:
            return
        cols = max(2, int(cols))
        rows = max(1, int(rows))
        with self.condition:
            if cols == self.cols and rows == self.rows:
                return
            # Keep output appends behind this boundary so replay can apply the
            # exact geometry that was active for every byte in the buffer.
            self.backend.resize(cols, rows)
            self.cols = cols
            self.rows = rows
            # Record every step, even without output between them: ConPTY
            # reflows its own buffer on each resize, so 38 -> 37 -> 38 rows
            # leaves content one row higher than never resizing at all.
            self.event_seq += 1
            self.resize_events.append({"seq": self.event_seq, "cursor": self.cursor, "cols": cols, "rows": rows})
            if len(self.resize_events) > RESIZE_EVENT_LIMIT:
                del self.resize_events[1:len(self.resize_events) - RESIZE_EVENT_LIMIT + 1]
            self.condition.notify_all()
        # ConPTY emits nothing when it reflows its buffer, so report the result
        # it actually produced for consumers to verify their own reflow.
        self.request_screen("resize")

    @property
    def supports_screen(self) -> bool:
        return bool(getattr(self.backend, "supports_screen", False))

    def request_screen(self, reason: str) -> bool:
        """Schedule an ordered read of the console's own screen buffer."""
        if self.exited or not self.supports_screen:
            return False
        with self.screen_capture_lock:
            # A resize and a verification read observe the same screen; keep
            # the more specific reason when both are pending.
            if self.screen_capture_pending != "resize":
                self.screen_capture_pending = reason
            if self.screen_capture_running:
                return True
            self.screen_capture_running = True
        threading.Thread(
            target=self._run_screen_captures,
            name=f"wmux-agent-screen-{self.id}",
            daemon=True,
        ).start()
        return True

    def _run_screen_captures(self) -> None:
        while True:
            with self.screen_capture_lock:
                reason = self.screen_capture_pending
                self.screen_capture_pending = None
                if reason is None or self.exited:
                    self.screen_capture_running = False
                    return
            try:
                self._capture_screen(reason)
            except Exception as error:
                print(f"{agent_program_name()}: screen read failed for {self.id}: {error}", file=sys.stderr)

    def _capture_screen(self, reason: str) -> None:
        for _attempt in range(SCREEN_CAPTURE_ATTEMPTS):
            if self.exited:
                return
            self._wait_for_quiet_output()
            with self.condition:
                start = self.cursor
                geometry = (self.cols, self.rows)
            screen = self.backend.read_screen()
            # Output the console produced before the read may still be in the
            # pipe. Give the reader a moment to surface it before trusting the
            # read as exact at `start`.
            time.sleep(SCREEN_CAPTURE_SETTLE_SECONDS)
            with self.condition:
                if self.exited:
                    return
                if (
                    self.cursor == start
                    and (self.cols, self.rows) == geometry == (screen["cols"], screen["rows"])
                ):
                    self.event_seq += 1
                    self.screen_events.append({"seq": self.event_seq, "cursor": start, "reason": reason, **screen})
                    del self.screen_events[:-SCREEN_EVENT_LIMIT]
                    self.condition.notify_all()
                    return

    def _wait_for_quiet_output(self) -> None:
        deadline = time.monotonic() + SCREEN_CAPTURE_QUIET_LIMIT_SECONDS
        while True:
            now = time.monotonic()
            idle = now - self.last_output_at
            if idle >= SCREEN_CAPTURE_QUIET_SECONDS or now >= deadline:
                return
            time.sleep(min(SCREEN_CAPTURE_QUIET_SECONDS - idle, deadline - now))

    def terminate(self) -> None:
        if self.exited:
            return
        self.backend.terminate()

    def read_from(self, cursor: int, timeout_ms: int, event_seq: int | None = None) -> dict[str, Any]:
        deadline = time.monotonic() + max(0, timeout_ms) / 1000
        with self.condition:
            while (
                cursor >= self.cursor
                and not self.exited
                and (event_seq is None or self.event_seq <= event_seq)
            ):
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                self.condition.wait(remaining)
            cursor = max(cursor, self.base)
            offset = cursor - self.base
            data = bytes(self.buffer[offset:])
            end_cursor = self.cursor
            if event_seq is None:
                # Consumers that predate event sequences address resizes by
                # byte range alone.
                resizes = [event for event in self.resize_events if cursor < event["cursor"] <= end_cursor]
                earlier = [event for event in self.resize_events if event["cursor"] <= cursor]
            else:
                # Events are ordered by sequence rather than byte range: an
                # event recorded at the current cursor is newer than bytes the
                # consumer already holds, yet still applies at that position.
                resizes = [
                    event for event in self.resize_events
                    if event["seq"] > event_seq and cursor <= event["cursor"] <= end_cursor
                ]
                returned = {event["seq"] for event in resizes}
                earlier = [
                    event for event in self.resize_events
                    if event["cursor"] <= cursor and event["seq"] not in returned
                ]
            geometry = earlier[-1] if earlier else self.resize_events[0]
            response = {
                "base": self.base,
                "startCursor": cursor,
                "cursor": end_cursor,
                "cols": geometry["cols"],
                "rows": geometry["rows"],
                "resizes": [{key: event[key] for key in ("seq", "cursor", "cols", "rows")} for event in resizes],
                "dataBase64": base64.b64encode(data).decode("ascii") if data else "",
                "exited": self.exited,
                "exitCode": self.exit_code,
                "cwd": self.cwd,
            }
            if event_seq is not None:
                response["screens"] = [
                    event for event in self.screen_events
                    if event["seq"] > event_seq and cursor <= event["cursor"] <= end_cursor
                ]
                response["eventSeq"] = self.event_seq
            return response

    def _create_backend(self, payload: dict[str, Any]) -> StdioBackend | ConptyBackend | PosixPtyBackend:
        backend = configured_backend(self.config)
        if backend == BACKEND_STDIO:
            return StdioBackend(self.config, payload, self.cwd)
        if backend == BACKEND_PTY:
            return PosixPtyBackend(
                self.config,
                payload,
                self.cwd,
                self.cols,
                self.rows,
            )
        return ConptyBackend(self.config, payload, self.cwd, self.cols, self.rows)

    def _read_output(self) -> None:
        try:
            self.exit_code = self.backend.read_output(self._append)
        except Exception as error:
            self._append(f"\r\n[wmux-agent] backend read failed: {error}\r\n".encode("utf-8", errors="replace"))
            self.exit_code = None
        finally:
            self.exited = True
            self._append(f"\r\n[wmux-agent] process exited with code {self.exit_code}\r\n".encode("utf-8"))
            with self.condition:
                self.condition.notify_all()
            if self.on_exit:
                self.on_exit()

    def _append(self, data: bytes) -> None:
        reported_cwds = self.cwd_reporter.feed(data)
        if reported_cwds:
            self.cwd = reported_cwds[-1]
        with self.condition:
            self.last_output_at = time.monotonic()
            self.buffer.extend(data)
            if len(self.buffer) > self.max_replay:
                overflow = len(self.buffer) - self.max_replay
                del self.buffer[:overflow]
                self.base += overflow
                prior = [event for event in self.resize_events if event["cursor"] <= self.base]
                later = [event for event in self.resize_events if event["cursor"] > self.base]
                self.resize_events = ([prior[-1]] if prior else []) + later
            self.condition.notify_all()


class AgentState:
    def __init__(self, config: dict[str, Any]):
        self.config = config
        self.backend = configured_backend(config)
        # Snapshot the bundle identity at process start. Staging a replacement
        # bundle must not make this still-running generation report itself as
        # current before it has restarted into the staged agent code.
        self.helper_bundle_version = helper_bundle_version(config)
        self.sessions: dict[str, Session] = {}
        self.lock = threading.Lock()
        self.draining = False
        self.update_pending = False
        self.restart_when_idle = False
        self.restart_requested = False
        self.restart_scheduled = False
        self.shutdown_callback: Callable[[], None] | None = None
        self.registration_heartbeat: RegistrationHeartbeat | None = None
        self.stream_supervisor: StreamSupervisor | None = None

    def get_or_create(self, session_id: str, payload: dict[str, Any]) -> Session:
        with self.lock:
            existing = self.sessions.get(session_id)
            if existing and not existing.exited:
                return existing
            if self.draining:
                raise AgentDrainingError("agent is draining; close existing panes or cancel the drain before creating a new pane")
            session = Session(session_id, self.config, payload, self._session_exited)
            self.sessions[session_id] = session
            return session

    def get(self, session_id: str) -> Session | None:
        with self.lock:
            return self.sessions.get(session_id)

    def delete(self, session_id: str) -> bool:
        with self.lock:
            session = self.sessions.pop(session_id, None)
        if not session:
            return False
        session.terminate()
        self._schedule_restart_if_idle()
        return True

    def list_sessions(self) -> list[dict[str, Any]]:
        with self.lock:
            return [session.snapshot() for session in self.sessions.values()]

    def health(self) -> dict[str, Any]:
        with self.lock:
            active_sessions = sum(1 for session in self.sessions.values() if not session.exited)
            return {
                "sessions": len(self.sessions),
                "activeSessions": active_sessions,
                "draining": self.draining,
                "updatePending": self.update_pending,
                "restartWhenIdle": self.restart_when_idle,
            }

    def begin_drain(self, restart_when_idle: bool, allow_new_sessions: bool = False) -> dict[str, Any]:
        with self.lock:
            self.update_pending = restart_when_idle and allow_new_sessions
            self.draining = not self.update_pending
            self.restart_when_idle = restart_when_idle
        self._schedule_restart_if_idle()
        return self.health()

    def cancel_drain(self) -> dict[str, Any]:
        with self.lock:
            if not self.restart_requested:
                self.draining = False
                self.update_pending = False
                self.restart_when_idle = False
        return self.health()

    def set_shutdown_callback(self, callback: Callable[[], None]) -> None:
        self.shutdown_callback = callback

    def set_registration_heartbeat(self, heartbeat: RegistrationHeartbeat) -> None:
        self.registration_heartbeat = heartbeat

    def set_stream_supervisor(self, supervisor: StreamSupervisor) -> None:
        self.stream_supervisor = supervisor

    def registration_heartbeat_health(self) -> dict[str, Any]:
        if self.registration_heartbeat:
            return self.registration_heartbeat.snapshot()
        return {
            "enabled": False,
            "owner": False,
            "configured": False,
            "intervalSeconds": DEFAULT_HEARTBEAT_INTERVAL_SECONDS,
            "lastAttemptAt": None,
            "lastSuccessAt": None,
            "lastFailureAt": None,
            "consecutiveFailures": 0,
            "lastError": None,
        }

    def stream_supervisor_health(self) -> dict[str, Any]:
        if self.stream_supervisor:
            return self.stream_supervisor.snapshot()
        return {
            "owner": False,
            "enabled": False,
            "configured": False,
            "running": False,
            "pid": None,
            "restartCount": 0,
            "lastStartedAt": None,
            "lastExitAt": None,
            "lastExitCode": None,
            "lastError": None,
        }

    def _session_exited(self) -> None:
        self._schedule_restart_if_idle()

    def _schedule_restart_if_idle(self) -> None:
        with self.lock:
            active_sessions = any(not session.exited for session in self.sessions.values())
            if (
                active_sessions
                or not (self.draining or self.update_pending)
                or not self.restart_when_idle
                or self.restart_requested
                or self.restart_scheduled
            ):
                return
            self.restart_scheduled = True
        timer = threading.Timer(0.25, self._restart_if_still_idle)
        timer.daemon = True
        timer.start()

    def _restart_if_still_idle(self) -> None:
        with self.lock:
            self.restart_scheduled = False
            active_sessions = any(not session.exited for session in self.sessions.values())
            if active_sessions or not (self.draining or self.update_pending) or not self.restart_when_idle or self.restart_requested:
                return
            # Close the create/restart race atomically. Pending updates accept
            # panes while any session is active, then become a hard drain only
            # for the brief interval between the final close and process exit.
            self.draining = True
            self.update_pending = False
            self.restart_requested = True
            callback = self.shutdown_callback
        if callback:
            callback()


class Handler(BaseHTTPRequestHandler):
    state: AgentState

    def log_message(self, message: str, *args: Any) -> None:
        print(f"{agent_program_name()}: {self.address_string()} {message % args}", file=sys.stderr)

    def authorized(self) -> bool:
        expected = str(self.state.config.get("token") or os.environ.get("WMUX_AGENT_TOKEN") or "")
        if not expected:
            return True
        header = self.headers.get("authorization") or ""
        match = re.match(r"^Bearer\s+(.+)$", header.strip(), re.IGNORECASE)
        presented = match.group(1).strip() if match else ""
        # Length-independent compare_digest guards against timing discovery.
        return bool(presented) and hmac.compare_digest(presented, expected)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        parts = [unquote(part) for part in parsed.path.strip("/").split("/") if part]
        if parsed.path == WINDOWS_AGENT_HEALTH_PATH:
            lifecycle = self.state.health()
            release_version = agent_release_version(self.state.config)
            self.send_json(
                {
                    "ok": True,
                    # `version` remains as a transition alias for wmux servers
                    # that predate the structured release/protocol fields.
                    "version": release_version,
                    "releaseVersion": release_version,
                    "protocolVersion": PROTOCOL_VERSION,
                    "capabilities": [capability for capability in WINDOWS_AGENT_CAPABILITIES
                                     if agent_capability_available(capability, self.state.backend)],
                    "machine": config_string(self.state.config, "machine", "windows"),
                    "pid": os.getpid(),
                    **lifecycle,
                    "backend": self.state.backend,
                    "processTree": "windows-job" if os.name == "nt" else "posix-session",
                    "helperBundleVersion": self.state.helper_bundle_version,
                    "conptyAvailable": conpty_available(),
                    "pywinptyAvailable": pywinpty_available(),
                    "heartbeat": self.state.registration_heartbeat_health(),
                    "stream": self.state.stream_supervisor_health(),
                }
            )
            return
        if not self.authorized():
            self.send_json({"error": "unauthorized"}, status=401)
            return
        if parsed.path == WINDOWS_AGENT_SESSIONS_PATH:
            self.send_json({"sessions": self.state.list_sessions()})
            return
        if parsed.path == WINDOWS_AGENT_DRAIN_PATH:
            self.send_json(self.state.health())
            return
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "output":
            session = self.require_session(parts[1])
            if not session:
                return
            query = parse_qs(parsed.query)
            cursor = int(query.get("cursor", ["0"])[0] or "0")
            timeout_ms = min(
                WINDOWS_AGENT_LONG_POLL_MAXIMUM_MS,
                int(query.get("timeoutMs", [str(WINDOWS_AGENT_LONG_POLL_DEFAULT_MS)])[0]
                    or str(WINDOWS_AGENT_LONG_POLL_DEFAULT_MS)),
            )
            event_seq_values = query.get("eventSeq")
            event_seq = int(event_seq_values[0]) if event_seq_values and event_seq_values[0] else None
            self.send_json(session.read_from(cursor, timeout_ms, event_seq))
            return
        self.send_json({"error": "not_found"}, status=404)

    def do_POST(self) -> None:
        if not self.authorized():
            self.send_json({"error": "unauthorized"}, status=401)
            return
        parsed = urlparse(self.path)
        parts = [unquote(part) for part in parsed.path.strip("/").split("/") if part]
        if parsed.path == WINDOWS_AGENT_DRAIN_PATH:
            body = self.read_json()
            self.send_json(self.state.begin_drain(
                body.get("restartWhenIdle") is not False,
                body.get("allowNewSessions") is True,
            ))
            return
        if len(parts) == 2 and parts[0] == "sessions":
            try:
                payload = self.read_json()
                stage_helper_bundle(self.state.config, payload)
                stage_runtime_files(payload, parts[1])
                session = self.state.get_or_create(parts[1], payload)
            except AgentDrainingError as error:
                self.send_json({"error": "agent_draining", "message": str(error)}, status=503)
                return
            except Exception as error:
                self.send_json({"error": "session_start_failed", "message": str(error)}, status=500)
                return
            self.send_json(session.snapshot())
            return
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "input":
            session = self.require_session(parts[1])
            if not session:
                return
            body = self.read_json()
            data = base64.b64decode(str(body.get("dataBase64") or ""))
            session.write(data, terminal_response=body.get("terminalResponse") is True)
            self.send_json({"ok": True})
            return
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "screen":
            session = self.require_session(parts[1])
            if not session:
                return
            self.send_json({"scheduled": session.request_screen("verify")}, status=202)
            return
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "resize":
            session = self.require_session(parts[1])
            if not session:
                return
            body = self.read_json()
            session.resize(int(body.get("cols") or 80), int(body.get("rows") or 24))
            self.send_json({"ok": True})
            return
        if len(parts) == 4 and parts[0] == "sessions" and parts[2] == "paste-images":
            session = self.require_session(parts[1])
            if not session or session.exited:
                if session:
                    self.send_json({"error": "session_exited"}, status=409)
                return
            query = parse_qs(parsed.query)
            extension = str(query.get("extension", [""])[0]).lower()
            content_type = (self.headers.get("content-type") or "").split(";", 1)[0].strip().lower()
            if content_type != "application/octet-stream":
                self.send_json({"error": "invalid_content_type"}, status=415)
                return
            length_header = self.headers.get("content-length")
            try:
                length = int(length_header or "")
            except ValueError:
                length = -1
            if length <= 0 or length > MAX_PASTE_IMAGE_BYTES:
                self.send_json({"error": "invalid_content_length"}, status=413 if length > MAX_PASTE_IMAGE_BYTES else 411)
                return
            data = self.rfile.read(length)
            if len(data) != length:
                self.send_json({"error": "incomplete_body"}, status=400)
                return
            if self.state.get(parts[1]) is not session or session.exited:
                self.send_json({"error": "session_exited"}, status=409)
                return
            try:
                result = stage_paste_image(self.state.config, parts[1], parts[3], extension, data)
            except (OSError, ValueError):
                self.send_json({"error": "paste_image_stage_failed"}, status=400)
                return
            self.send_json(result, status=201)
            return
        self.send_json({"error": "not_found"}, status=404)

    def do_DELETE(self) -> None:
        if not self.authorized():
            self.send_json({"error": "unauthorized"}, status=401)
            return
        parsed = urlparse(self.path)
        parts = [unquote(part) for part in parsed.path.strip("/").split("/") if part]
        if parsed.path == WINDOWS_AGENT_DRAIN_PATH:
            self.send_json(self.state.cancel_drain())
            return
        if len(parts) == 2 and parts[0] == "sessions":
            removed = self.state.delete(parts[1])
            delete_session_paste_images(self.state.config, parts[1])
            delete_session_runtime_files(parts[1])
            self.send_json({"removed": removed})
            return
        if len(parts) == 4 and parts[0] == "sessions" and parts[2] == "paste-images":
            self.send_json({"removed": delete_paste_image(self.state.config, parts[1], parts[3])})
            return
        self.send_json({"error": "not_found"}, status=404)

    def read_json(self) -> dict[str, Any]:
        length = int(self.headers.get("content-length") or "0")
        if length <= 0:
            return {}
        raw = self.rfile.read(min(length, 2 * 1024 * 1024)).decode("utf-8")
        value = json.loads(raw)
        return value if isinstance(value, dict) else {}

    def require_session(self, session_id: str) -> Session | None:
        session = self.state.get(session_id)
        if session:
            return session
        self.send_json({"error": "unknown_session"}, status=404)
        return None

    def send_json(self, payload: Any, status: int = 200) -> None:
        data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def main() -> int:
    program = agent_program_name()
    default_config = (
        os.environ.get("WMUX_WINDOWS_AGENT_CONFIG", "~/.wmux/windows-agent.json")
        if os.name == "nt"
        else os.environ.get("WMUX_SESSION_AGENT_CONFIG", "~/.wmux/session-agent.json")
    )
    parser = argparse.ArgumentParser(prog=program)
    parser.add_argument("--config", default=default_config)
    parser.add_argument("--host", default="")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--allow-public-bind", action="store_true")
    parser.add_argument("--read-console-screen", type=int, metavar="PID", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.read_console_screen is not None:
        sys.stdout.write(json.dumps(read_console_screen(args.read_console_screen), separators=(",", ":")))
        sys.stdout.flush()
        return 0
    config = load_config(args.config)
    host = args.host or config_string(config, "host", "127.0.0.1")
    port = args.port or config_int(config, "port", 3481)
    if not args.allow_public_bind and not is_private_bind_host(host):
        raise SystemExit(f"{program}: refusing to bind non-private host {host}")
    Handler.state = AgentState(config)
    server = ThreadingHTTPServer((host, port), Handler)
    registration_heartbeat = RegistrationHeartbeat(config, args.config, int(server.server_address[1]))
    stream_supervisor = StreamSupervisor(config, args.config)
    Handler.state.set_registration_heartbeat(registration_heartbeat)
    Handler.state.set_stream_supervisor(stream_supervisor)
    Handler.state.set_shutdown_callback(lambda: threading.Thread(target=server.shutdown, daemon=True).start())
    if registration_heartbeat.owner:
        retire_legacy_heartbeat_task(config)
    if registration_heartbeat.enabled:
        registration_heartbeat.start()
    stream_supervisor.start()
    print(f"{program}: listening on http://{host}:{port}", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        return 0
    finally:
        stream_supervisor.stop()
        registration_heartbeat.stop()
        server.server_close()
    return AGENT_RESTART_EXIT_CODE if Handler.state.restart_requested else 0


if __name__ == "__main__":
    raise SystemExit(main())
