diff --git a/lib/renderer-fractional-dpr.test.ts b/lib/renderer-fractional-dpr.test.ts
new file mode 100644
index 0000000..2ade65c
--- /dev/null
+++ b/lib/renderer-fractional-dpr.test.ts
@@ -0,0 +1,62 @@
+/**
+ * Renderer backing-store sizing at fractional device pixel ratios.
+ *
+ * BUG: render() compared canvas.width, which the browser truncates to an
+ * integer, with the unrounded product cols * cellWidth * devicePixelRatio.
+ * At a fractional ratio such as 1.1 the two never matched, so every frame
+ * resized the canvas and repainted the whole terminal.
+ */
+
+import { describe, expect, test } from 'bun:test';
+import { CanvasRenderer } from './renderer';
+import type { IRenderable } from './renderer';
+import type { GhosttyCell } from './types';
+
+function line(cols: number): GhosttyCell[] {
+  return Array.from({ length: cols }, () => ({
+    codepoint: 0x41,
+    fg_r: 200,
+    fg_g: 200,
+    fg_b: 200,
+    bg_r: 0,
+    bg_g: 0,
+    bg_b: 0,
+    flags: 0,
+    width: 1,
+    hyperlink_id: 0,
+    grapheme_len: 0,
+  }));
+}
+
+function buffer(cols: number, rows: number): IRenderable {
+  return {
+    getLine: (y) => (y >= 0 && y < rows ? line(cols) : null),
+    getCursor: () => ({ x: 0, y: 0, visible: false }),
+    getDimensions: () => ({ cols, rows }),
+    isRowDirty: () => false,
+    clearDirty() {},
+    getGraphemeString: () => 'A',
+  };
+}
+
+describe('Renderer fractional device pixel ratio', () => {
+  for (const devicePixelRatio of [1, 1.1, 1.25, 1.36, 2.2, 2.5]) {
+    test(`does not resize again on an idle render at ${devicePixelRatio}`, () => {
+      const canvas = document.createElement('canvas');
+      const renderer = new CanvasRenderer(canvas, { devicePixelRatio });
+      let resizes = 0;
+      const resize = renderer.resize.bind(renderer);
+      renderer.resize = (cols: number, rows: number) => {
+        resizes++;
+        resize(cols, rows);
+      };
+      const source = buffer(83, 29);
+      renderer.render(source, true);
+      renderer.render(source, false);
+      renderer.render(source, false);
+      expect(resizes).toBe(1);
+      expect(Number.isInteger(canvas.width)).toBe(true);
+      expect(canvas.width).toBe(Math.round(83 * renderer.getMetrics().width * devicePixelRatio));
+    });
+  }
+});
